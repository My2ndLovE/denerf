---
// Hero Section with Kinetic Typography and Morphing Blob
---

<section class="hero-section relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Morphing Blob Background -->
  <div class="hero-blob-container absolute inset-0 z-0">
    <canvas id="hero-blob-canvas" class="w-full h-full"></canvas>
  </div>

  <!-- Gradient overlays for depth -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-brand-purple opacity-20 blur-[120px] rounded-full animate-pulse-slow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-brand-cyan opacity-20 blur-[120px] rounded-full animate-pulse-slow" style="animation-delay: 2s;"></div>
  </div>

  <!-- Content Container -->
  <div class="container relative z-10">
    <div class="text-center">
      <!-- Main Headline with Split Text Animation -->
      <h1 class="hero-title mb-8">
        <span class="hero-line block" data-text="WE BUILD">
          <span class="hero-word inline-block">WE BUILD</span>
        </span>
        <span class="hero-line block text-gradient" data-text="THE FUTURE">
          <span class="hero-word inline-block">THE FUTURE</span>
        </span>
      </h1>

      <!-- Tagline -->
      <p class="hero-tagline text-xl md:text-2xl lg:text-3xl font-body font-light max-w-3xl mx-auto mb-12 opacity-0">
        Digital experiences that <span class="text-brand-cyan font-semibold">perform</span>.
        No fluff. Just <span class="text-brand-purple font-semibold">craft</span>.
      </p>

      <!-- CTA Buttons -->
      <div class="hero-cta flex flex-col sm:flex-row gap-6 justify-center items-center opacity-0">
        <a href="#contact" class="btn-primary group magnetic">
          <span class="relative z-10">Start a Project</span>
          <span class="btn-arrow">→</span>
        </a>

        <a href="#work" class="btn-secondary group magnetic">
          <span class="relative z-10">View Our Work</span>
          <span class="btn-arrow">↓</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
    <div class="scroll-icon-container">
      <svg class="scroll-icon" width="30" height="50" viewBox="0 0 30 50">
        <rect x="1" y="1" width="28" height="48" rx="14" stroke="currentColor" stroke-width="2" fill="none" class="text-brand-white opacity-50"/>
        <circle cx="15" cy="12" r="4" fill="currentColor" class="text-brand-cyan scroll-dot">
          <animate attributeName="cy" from="12" to="38" dur="1.5s" repeatCount="indefinite" />
        </circle>
      </svg>
      <p class="text-xs font-mono mt-2 opacity-50 tracking-wider">SCROLL</p>
    </div>
  </div>

  <!-- Custom Cursor Element -->
  <div id="custom-cursor" class="custom-cursor"></div>
</section>

<style>
  .hero-section {
    position: relative;
    background: var(--color-brand-black);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 15vw, 12rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  .hero-line {
    overflow: hidden;
    padding: 0.1em 0;
  }

  .hero-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(100%);
  }

  /* Button Styles */
  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 2.5rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    border-radius: 0;
    position: relative;
    overflow: hidden;
    transition: all var(--duration-base) var(--ease-out);
    cursor: none; /* Custom cursor will handle this */
  }

  .btn-primary {
    background: var(--color-brand-cyan);
    color: var(--color-brand-black);
    border: 2px solid var(--color-brand-cyan);
  }

  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background: var(--color-brand-purple);
    transition: width var(--duration-base) var(--ease-out);
    z-index: 0;
  }

  .btn-primary:hover::before {
    width: 100%;
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-white);
  }

  .btn-secondary::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background: var(--color-brand-white);
    transition: width var(--duration-base) var(--ease-out);
    z-index: 0;
  }

  .btn-secondary:hover::before {
    width: 100%;
  }

  .btn-secondary:hover {
    color: var(--color-brand-black);
  }

  .btn-arrow {
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-bounce);
  }

  .btn-primary:hover .btn-arrow {
    transform: translateX(4px);
  }

  .btn-secondary:hover .btn-arrow {
    transform: translateY(4px);
  }

  /* Custom Cursor */
  .custom-cursor {
    width: 40px;
    height: 40px;
    border: 2px solid var(--color-brand-cyan);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 9999;
    transition: all var(--duration-fast) var(--ease-out);
    opacity: 0;
    mix-blend-mode: difference;
  }

  .custom-cursor.active {
    transform: scale(1.5);
    background: var(--color-brand-cyan);
  }

  /* Scroll Indicator Animation */
  .scroll-indicator {
    animation: float 3s ease-in-out infinite;
  }

  .scroll-icon-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .btn-primary, .btn-secondary {
      width: 100%;
      max-width: 300px;
      justify-content: center;
    }
  }

  /* Hide custom cursor on touch devices */
  @media (hover: none) {
    .custom-cursor {
      display: none;
    }

    .btn-primary, .btn-secondary {
      cursor: pointer;
    }
  }
</style>

<script>
  // Hero Animation Script
  import { gsap } from 'gsap';

  // Animation setup after DOM is ready
  document.addEventListener('astro:page-load', () => {
    // Animate hero title words
    gsap.to('.hero-word', {
      y: 0,
      opacity: 1,
      duration: 1,
      stagger: 0.2,
      ease: 'power3.out',
      delay: 0.3
    });

    // Animate tagline
    gsap.to('.hero-tagline', {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: 'power2.out',
      delay: 1
    });

    // Animate CTAs
    gsap.to('.hero-cta', {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: 'power2.out',
      delay: 1.4
    });

    // Custom Cursor
    const cursor = document.getElementById('custom-cursor');
    const heroSection = document.querySelector('.hero-section');

    if (cursor && heroSection && window.matchMedia('(hover: hover)').matches) {
      let mouseX = 0;
      let mouseY = 0;
      let cursorX = 0;
      let cursorY = 0;

      // Show cursor when entering hero
      heroSection.addEventListener('mouseenter', () => {
        cursor.style.opacity = '1';
      });

      heroSection.addEventListener('mouseleave', () => {
        cursor.style.opacity = '0';
      });

      // Track mouse position
      heroSection.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      // Smooth cursor follow with lerp
      function animateCursor() {
        const dx = mouseX - cursorX;
        const dy = mouseY - cursorY;

        cursorX += dx * 0.1;
        cursorY += dy * 0.1;

        cursor.style.left = cursorX + 'px';
        cursor.style.top = cursorY + 'px';

        requestAnimationFrame(animateCursor);
      }

      animateCursor();

      // Cursor interactions with buttons
      const buttons = heroSection.querySelectorAll('.magnetic');
      buttons.forEach(btn => {
        btn.addEventListener('mouseenter', () => {
          cursor.classList.add('active');
        });
        btn.addEventListener('mouseleave', () => {
          cursor.classList.remove('active');
        });
      });
    }

    // Kinetic Typography - Text follows cursor slightly
    const heroTitle = document.querySelector('.hero-title');
    if (heroTitle && window.matchMedia('(hover: hover)').matches) {
      heroSection.addEventListener('mousemove', (e) => {
        const { clientX, clientY } = e;
        const { innerWidth, innerHeight } = window;

        const xPercent = (clientX / innerWidth - 0.5) * 20;
        const yPercent = (clientY / innerHeight - 0.5) * 20;

        gsap.to(heroTitle, {
          x: xPercent,
          y: yPercent,
          duration: 0.5,
          ease: 'power2.out'
        });
      });
    }
  });
</script>

<script>
  // Three.js Morphing Blob Background
  import * as THREE from 'three';

  document.addEventListener('astro:page-load', () => {
    const canvas = document.getElementById('hero-blob-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    // Scene setup
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      75,
      canvas.offsetWidth / canvas.offsetHeight,
      0.1,
      1000
    );
    camera.position.z = 5;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true
    });
    renderer.setSize(canvas.offsetWidth, canvas.offsetHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Blob geometry
    const geometry = new THREE.IcosahedronGeometry(2, 20);
    const material = new THREE.MeshPhongMaterial({
      color: 0x00f0ff,
      emissive: 0x6b2ff6,
      emissiveIntensity: 0.5,
      wireframe: false,
      transparent: true,
      opacity: 0.15
    });

    const blob = new THREE.Mesh(geometry, material);
    scene.add(blob);

    // Lighting
    const light1 = new THREE.PointLight(0x00f0ff, 2, 100);
    light1.position.set(5, 5, 5);
    scene.add(light1);

    const light2 = new THREE.PointLight(0x6b2ff6, 2, 100);
    light2.position.set(-5, -5, 5);
    scene.add(light2);

    // Animation
    let time = 0;
    function animate() {
      requestAnimationFrame(animate);

      time += 0.01;

      // Rotate blob
      blob.rotation.x = time * 0.2;
      blob.rotation.y = time * 0.3;

      // Morph effect - move vertices
      const positions = geometry.attributes.position;
      for (let i = 0; i < positions.count; i++) {
        const p = new THREE.Vector3(
          positions.getX(i),
          positions.getY(i),
          positions.getZ(i)
        );

        p.normalize().multiplyScalar(
          2 + 0.3 * Math.sin(time + p.x * 2) * Math.cos(time + p.y * 2)
        );

        positions.setXYZ(i, p.x, p.y, p.z);
      }
      positions.needsUpdate = true;

      renderer.render(scene, camera);
    }

    animate();

    // Resize handler
    function handleResize() {
      camera.aspect = canvas.offsetWidth / canvas.offsetHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(canvas.offsetWidth, canvas.offsetHeight);
    }

    window.addEventListener('resize', handleResize);

    // Cleanup on navigation
    document.addEventListener('astro:before-preparation', () => {
      window.removeEventListener('resize', handleResize);
      renderer.dispose();
      geometry.dispose();
      material.dispose();
    });
  });
</script>
