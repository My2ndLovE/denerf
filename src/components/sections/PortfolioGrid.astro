</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animate project cards on scroll
  const projectCards = document.querySelectorAll('.project-card');

  projectCards.forEach((card) => {
    ScrollTrigger.create({
      trigger: card,
      start: 'top 85%',
      onEnter: () => {
        gsap.to(card, {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: 'power3.out',
        });
      },
      once: true,
    });
  });

  // Filter functionality
  const filterTags = document.querySelectorAll('.filter-tag');
  const allProjects = document.querySelectorAll('.project-card');

  filterTags.forEach((tag) => {
    tag.addEventListener('click', () => {
      const filter = tag.getAttribute('data-filter');

      // Update active state
      filterTags.forEach((t) => t.classList.remove('active', 'bg-primary', 'text-void'));
      tag.classList.add('active', 'bg-primary', 'text-void');

      // Filter projects
      allProjects.forEach((project) => {
        const industry = project.getAttribute('data-industry');
        const tags = project.getAttribute('data-tags');

        if (filter === 'all') {
          gsap.to(project, {
            opacity: 1,
            scale: 1,
            duration: 0.3,
            display: 'block',
          });
        } else if (industry?.includes(filter) || tags?.includes(filter)) {
          gsap.to(project, {
            opacity: 1,
            scale: 1,
            duration: 0.3,
            display: 'block',
          });
        } else {
          gsap.to(project, {
            opacity: 0,
            scale: 0.9,
            duration: 0.3,
            display: 'none',
          });
        }
      });
    });
  });

  // Hover effect with GSAP
  allProjects.forEach((card) => {
    card.addEventListener('mouseenter', () => {
      gsap.to(card, {
        y: -8,
        duration: 0.3,
        ease: 'power2.out',
      });
    });

    card.addEventListener('mouseleave', () => {
      gsap.to(card, {
        y: 0,
        duration: 0.3,
        ease: 'power2.out',
      });
    });
  });
</script>

<style>
  .filter-tag.active {
    @apply bg-primary text-void border-primary;
  }

  .project-card {
    will-change: transform, opacity;
  }
</style>
