---
---

<section id="cta" class="section bg-gradient-to-b from-base via-surface to-base">
  <div class="container max-w-6xl">
    <h2 class="text-section mb-6 text-center animate-on-scroll">
      Let's Build Something <span class="gradient-text">Unexpected</span>
    </h2>

    <p class="text-xl text-text-muted text-center mb-16 max-w-3xl mx-auto animate-on-scroll">
      Choose your adventure. We're ready when you are.
    </p>

    <!-- Three Paths -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <!-- Path 1: Quick Question -->
      <div class="card bg-surface/50 backdrop-blur-sm border border-primary/20 hover:border-primary/50 transition-all group animate-on-scroll">
        <div class="text-5xl mb-4">💬</div>
        <h3 class="text-2xl font-bold mb-3 text-accent group-hover:text-primary transition-colors">
          Quick Question
        </h3>
        <p class="text-text-muted mb-6">
          Got a question about a project idea? We'll reply within 4 hours during business hours.
        </p>

        <form class="space-y-4" data-netlify="true" name="quick-question">
          <input type="hidden" name="form-name" value="quick-question" />

          <div>
            <label for="email-quick" class="block text-sm font-semibold text-text-primary mb-2">
              Email
            </label>
            <input
              type="email"
              id="email-quick"
              name="email"
              required
              class="w-full px-4 py-3 bg-base border border-surface focus:border-primary rounded-lg text-text-primary focus:outline-none transition-colors"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label for="message-quick" class="block text-sm font-semibold text-text-primary mb-2">
              Your Question
            </label>
            <textarea
              id="message-quick"
              name="message"
              required
              rows="4"
              class="w-full px-4 py-3 bg-base border border-surface focus:border-primary rounded-lg text-text-primary focus:outline-none transition-colors resize-none"
              placeholder="What's on your mind?"
            ></textarea>
          </div>

          <button
            type="submit"
            class="btn btn-primary w-full group-hover:scale-105"
          >
            Send Message
          </button>
        </form>
      </div>

      <!-- Path 2: I Have a Project -->
      <div class="card bg-surface/50 backdrop-blur-sm border border-secondary/20 hover:border-secondary/50 transition-all group animate-on-scroll" style="animation-delay: 0.1s">
        <div class="text-5xl mb-4">🚀</div>
        <h3 class="text-2xl font-bold mb-3 text-accent group-hover:text-secondary transition-colors">
          I Have a Project
        </h3>
        <p class="text-text-muted mb-6">
          Ready to build something amazing? Tell us about your vision and we'll make it real.
        </p>

        <form class="space-y-4" data-netlify="true" name="project-inquiry">
          <input type="hidden" name="form-name" value="project-inquiry" />

          <div>
            <label for="name-project" class="block text-sm font-semibold text-text-primary mb-2">
              Your Name
            </label>
            <input
              type="text"
              id="name-project"
              name="name"
              required
              class="w-full px-4 py-3 bg-base border border-surface focus:border-secondary rounded-lg text-text-primary focus:outline-none transition-colors"
              placeholder="Jane Doe"
            />
          </div>

          <div>
            <label for="email-project" class="block text-sm font-semibold text-text-primary mb-2">
              Email
            </label>
            <input
              type="email"
              id="email-project"
              name="email"
              required
              class="w-full px-4 py-3 bg-base border border-surface focus:border-secondary rounded-lg text-text-primary focus:outline-none transition-colors"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label for="project-desc" class="block text-sm font-semibold text-text-primary mb-2">
              Project Description
            </label>
            <textarea
              id="project-desc"
              name="project"
              required
              rows="4"
              class="w-full px-4 py-3 bg-base border border-surface focus:border-secondary rounded-lg text-text-primary focus:outline-none transition-colors resize-none"
              placeholder="What are you building?"
            ></textarea>
          </div>

          <div>
            <label for="timeline" class="block text-sm font-semibold text-text-primary mb-2">
              Timeline
            </label>
            <select
              id="timeline"
              name="timeline"
              required
              class="w-full px-4 py-3 bg-base border border-surface focus:border-secondary rounded-lg text-text-primary focus:outline-none transition-colors"
            >
              <option value="">Select timeline...</option>
              <option value="asap">ASAP (under 1 month)</option>
              <option value="1-3months">1-3 months</option>
              <option value="3-6months">3-6 months</option>
              <option value="flexible">Flexible</option>
            </select>
          </div>

          <button
            type="submit"
            class="btn w-full bg-gradient-to-r from-secondary to-primary text-base hover:scale-105 transition-transform"
          >
            Let's Do This
          </button>
        </form>
      </div>

      <!-- Path 3: Just Exploring -->
      <div class="card bg-surface/50 backdrop-blur-sm border border-accent/20 hover:border-accent/50 transition-all group animate-on-scroll" style="animation-delay: 0.2s">
        <div class="text-5xl mb-4">🔍</div>
        <h3 class="text-2xl font-bold mb-3 text-accent group-hover:text-accent transition-colors">
          Just Exploring
        </h3>
        <p class="text-text-muted mb-6">
          Not ready to commit? That's cool. Here are some ways to stay connected.
        </p>

        <div class="space-y-4">
          <!-- Newsletter -->
          <div class="p-4 bg-base/50 rounded-lg border border-surface hover:border-primary/50 transition-colors">
            <h4 class="font-semibold text-text-primary mb-2">📬 Newsletter</h4>
            <p class="text-sm text-text-muted mb-3">
              Monthly insights on web development, design, and technology. No spam, ever.
            </p>
            <form class="flex gap-2" data-netlify="true" name="newsletter">
              <input type="hidden" name="form-name" value="newsletter" />
              <input
                type="email"
                name="email"
                required
                placeholder="your@email.com"
                class="flex-1 px-3 py-2 text-sm bg-base border border-surface focus:border-primary rounded text-text-primary focus:outline-none"
              />
              <button
                type="submit"
                class="px-4 py-2 bg-primary text-base text-sm font-semibold rounded hover:bg-primary/90 transition-colors"
              >
                Subscribe
              </button>
            </form>
          </div>

          <!-- Social Links -->
          <div class="p-4 bg-base/50 rounded-lg border border-surface">
            <h4 class="font-semibold text-text-primary mb-3">🔗 Connect</h4>
            <div class="space-y-2">
              <a
                href="https://github.com"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-text-muted hover:text-primary transition-colors"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                <span>GitHub</span>
              </a>

              <a
                href="https://linkedin.com"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-text-muted hover:text-primary transition-colors"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
                <span>LinkedIn</span>
              </a>

              <a
                href="mailto:hello@denerf.com"
                class="flex items-center gap-2 text-text-muted hover:text-primary transition-colors"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <span>hello@denerf.com</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="text-center pt-16 border-t border-primary/20 animate-on-scroll">
      <p class="text-text-muted mb-2">
        Built with <span class="text-primary">Astro</span>, <span class="text-primary">React</span>, and <span class="text-primary">love</span>
      </p>
      <p class="text-sm text-text-muted/60">
        © {new Date().getFullYear()} denerf. Crafting digital experiences that feel alive.
      </p>
    </footer>
  </div>
</section>

<style>
  /* Form focus effects */
  input:focus,
  textarea:focus,
  select:focus {
    box-shadow: 0 0 0 3px rgba(0, 245, 255, 0.1);
  }

  /* Button hover effects */
  .btn:hover {
    animation: pulse-button 1s ease-in-out;
  }

  @keyframes pulse-button {
    0%, 100% {
      box-shadow: 0 8px 24px rgba(0, 245, 255, 0.4);
    }
    50% {
      box-shadow: 0 8px 32px rgba(0, 245, 255, 0.6);
    }
  }
</style>
