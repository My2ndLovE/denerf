---
// Chapter 5: THE INVITATION - "The Adaptive Form"
// CTA that demonstrates AI capabilities through its own existence
---

<section
  id="contact"
  class="section min-h-screen flex items-center justify-center relative"
  aria-label="Contact - The Invitation"
>
  <div class="container max-w-2xl">
    <h2 class="text-5xl font-bold text-center mb-8 text-gradient">
      Let's Build Your Impossible Idea
    </h2>
    <p class="text-xl text-text-secondary text-center mb-16">
      No idea is too ambitious. No timeline too aggressive. Let's see what AI can do for you.
    </p>

    <!-- Adaptive Form -->
    <form id="contact-form" class="space-y-8">
      <!-- Step 1: Name -->
      <div class="form-step active" data-step="1">
        <label for="name" class="block text-lg mb-3">
          What should we call you?
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-6 py-4 rounded-lg bg-elevated border border-surface focus:border-primary outline-none transition-colors text-text-primary"
          placeholder="Your name"
        />
      </div>

      <!-- Step 2: Email -->
      <div class="form-step" data-step="2">
        <label for="email" class="block text-lg mb-3">
          Where should we send your AI-powered estimate?
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-6 py-4 rounded-lg bg-elevated border border-surface focus:border-primary outline-none transition-colors text-text-primary"
          placeholder="your@email.com"
        />
        <span class="validation-check hidden text-success text-sm mt-2">✓ Looks good!</span>
      </div>

      <!-- Step 3: Project Description -->
      <div class="form-step" data-step="3">
        <label for="project" class="block text-lg mb-3">
          Describe your impossible idea
        </label>
        <textarea
          id="project"
          name="project"
          required
          rows="6"
          class="w-full px-6 py-4 rounded-lg bg-elevated border border-surface focus:border-primary outline-none transition-colors text-text-primary resize-none"
          placeholder="We want to build an app that..."
        ></textarea>
        <!-- Word cloud visualization (will be canvas) -->
        <div id="word-cloud" class="mt-4 h-24" aria-hidden="true"></div>
      </div>

      <!-- Step 4: Timeline -->
      <div class="form-step" data-step="4">
        <label class="block text-lg mb-4">
          When do you need it?
        </label>
        <div class="grid grid-cols-2 gap-4">
          <label class="timeline-option">
            <input type="radio" name="timeline" value="asap" class="sr-only" />
            <div class="option-card glass p-4 rounded-lg cursor-pointer transition-all duration-300">
              <div class="font-semibold mb-1">ASAP</div>
              <div class="text-sm text-text-tertiary">2-4 weeks</div>
            </div>
          </label>
          <label class="timeline-option">
            <input type="radio" name="timeline" value="soon" class="sr-only" />
            <div class="option-card glass p-4 rounded-lg cursor-pointer transition-all duration-300">
              <div class="font-semibold mb-1">Soon</div>
              <div class="text-sm text-text-tertiary">1-3 months</div>
            </div>
          </label>
          <label class="timeline-option">
            <input type="radio" name="timeline" value="planning" class="sr-only" />
            <div class="option-card glass p-4 rounded-lg cursor-pointer transition-all duration-300">
              <div class="font-semibold mb-1">Planning</div>
              <div class="text-sm text-text-tertiary">3-6 months</div>
            </div>
          </label>
          <label class="timeline-option">
            <input type="radio" name="timeline" value="exploring" class="sr-only" />
            <div class="option-card glass p-4 rounded-lg cursor-pointer transition-all duration-300">
              <div class="font-semibold mb-1">Exploring</div>
              <div class="text-sm text-text-tertiary">Just looking</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Step 5: Budget (Optional) -->
      <div class="form-step" data-step="5">
        <label for="budget" class="block text-lg mb-3">
          Estimated budget? <span class="text-text-tertiary text-sm">(Optional - helps us personalize)</span>
        </label>
        <select
          id="budget"
          name="budget"
          class="w-full px-6 py-4 rounded-lg bg-elevated border border-surface focus:border-primary outline-none transition-colors text-text-primary"
        >
          <option value="">Let's discuss</option>
          <option value="10-25">$10k - $25k</option>
          <option value="25-50">$25k - $50k</option>
          <option value="50-100">$50k - $100k</option>
          <option value="100+">$100k+</option>
        </select>
      </div>

      <!-- Submit Button -->
      <div class="text-center">
        <button
          type="submit"
          class="submit-btn px-12 py-4 bg-primary text-void font-semibold rounded-lg hover:bg-accent transition-all duration-300 transform hover:scale-105"
        >
          Start Your AI Project →
        </button>
      </div>

      <!-- Privacy Note -->
      <p class="text-sm text-text-tertiary text-center">
        Your idea is safe with us. We sign NDAs. Always.
      </p>
    </form>

    <!-- Success State (hidden by default) -->
    <div id="success-message" class="hidden text-center">
      <div class="text-6xl mb-6">🎉</div>
      <h3 class="text-3xl font-bold mb-4">Got It!</h3>
      <p class="text-lg text-text-secondary mb-8">
        Our AI is analyzing your project now...
      </p>
      <div class="glass p-8 rounded-lg text-left space-y-4 max-w-md mx-auto">
        <h4 class="font-semibold mb-4">What happens next:</h4>
        <div class="flex items-start gap-3">
          <span class="text-primary">→</span>
          <span class="text-sm">Within 24 hours: Personalized proposal in your inbox</span>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-primary">→</span>
          <span class="text-sm">AI-powered estimate with timeline and tech stack</span>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-primary">→</span>
          <span class="text-sm">Calendar link to discuss your vision</span>
        </div>
      </div>
      <p class="text-sm text-text-tertiary mt-8">
        - The DeNeRF Team
      </p>
    </div>

    <!-- Alternative Contact -->
    <div class="mt-16 text-center space-y-4">
      <p class="text-text-secondary">
        Prefer email? Reach us at: <a href="mailto:hello@denerf.ai" class="text-primary hover:text-accent">hello@denerf.ai</a>
      </p>
    </div>
  </div>
</section>

<style>
  .form-step {
    display: none;
    opacity: 0;
    animation: fadeIn 0.5s ease-in-out forwards;
  }

  .form-step.active {
    display: block;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .timeline-option input:checked + .option-card {
    border-color: var(--color-primary);
    background: rgba(0, 245, 255, 0.1);
  }

  .option-card {
    border: 1px solid transparent;
  }

  .option-card:hover {
    border-color: var(--color-primary);
  }
</style>

<script>
  // Simple form progression (will be enhanced with AI features)
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const steps = document.querySelectorAll('.form-step');
  let currentStep = 0;

  // Show all steps for now (multi-step logic to be implemented)
  steps.forEach(step => {
    step.classList.add('active');
  });

  // Form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Show success message
    form.classList.add('hidden');
    document.getElementById('success-message')?.classList.remove('hidden');

    // Particle burst animation (to be implemented)
    console.log('Form submitted - trigger particle burst!');
  });

  // Email validation
  const emailInput = document.getElementById('email') as HTMLInputElement;
  emailInput?.addEventListener('blur', () => {
    const validationCheck = document.querySelector('.validation-check');
    if (emailInput.validity.valid) {
      validationCheck?.classList.remove('hidden');
    }
  });
</script>
