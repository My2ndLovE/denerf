<section id="work" class="section-padding relative overflow-hidden bg-surface">
  <!-- Background -->
  <div class="absolute inset-0 neural-grid opacity-30"></div>

  <div class="container-custom relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-12 animate-on-scroll">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        Built With <span class="text-gradient">AI</span>.<br />
        Approved By Humans.
      </h2>
      <p class="text-xl text-text-secondary max-w-3xl mx-auto mb-8">
        Real projects. Real impact. Real innovation powered by AI.
      </p>

      <!-- Filter Tags -->
      <div class="flex flex-wrap justify-center gap-3" id="filter-tags">
        <button class="px-4 py-2 rounded-full border border-primary text-primary hover:bg-primary hover:text-void transition-all duration-300 filter-tag active" data-filter="all">
          All
        </button>
        <button class="px-4 py-2 rounded-full border border-elevated text-text-secondary hover:border-primary hover:text-primary transition-all duration-300 filter-tag" data-filter="E-Commerce">
          E-Commerce
        </button>
        <button class="px-4 py-2 rounded-full border border-elevated text-text-secondary hover:border-primary hover:text-primary transition-all duration-300 filter-tag" data-filter="FinTech">
          FinTech
        </button>
        <button class="px-4 py-2 rounded-full border border-elevated text-text-secondary hover:border-primary hover:text-primary transition-all duration-300 filter-tag" data-filter="SaaS">
          SaaS
        </button>
        <button class="px-4 py-2 rounded-full border border-elevated text-text-secondary hover:border-primary hover:text-primary transition-all duration-300 filter-tag" data-filter="Mobile">
          Mobile
        </button>
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="projects-grid">
      {projects.map((project, index) => (
        <div
          class="project-card card-hover group opacity-0 translate-y-8"
          data-industry={project.industry}
          data-tags={project.tags.join(',')}
          style={`transition-delay: ${index * 100}ms`}
        >
          <!-- Project Image Placeholder -->
          <div class="aspect-video bg-elevated rounded-lg mb-4 overflow-hidden relative">
            <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-accent/20 flex items-center justify-center">
              <svg class="w-16 h-16 text-primary/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            {/* Image will be added later */}
          </div>

          <!-- Project Info -->
          <div class="space-y-3">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold text-text-primary group-hover:text-gradient transition-all duration-300">
                {project.title}
              </h3>
              <span class="px-2 py-1 text-xs rounded-full bg-primary/20 text-primary flex-shrink-0">
                {project.industry}
              </span>
            </div>

            <p class="text-sm text-text-secondary">
              {project.description}
            </p>

            <!-- AI Tools -->
            <div class="flex flex-wrap gap-2">
              {project.aiTools.map((tool) => (
                <span class="px-2 py-1 text-xs rounded-full bg-accent/20 text-accent">
                  {tool}
                </span>
              ))}
            </div>

            <!-- Impact -->
            <div class="pt-3 border-t border-elevated">
              <div class="flex items-center gap-2 text-success">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
