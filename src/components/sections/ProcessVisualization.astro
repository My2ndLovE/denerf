---
// Section 2: The Collaboration - Human + AI Symphony
---

<section id="process" class="section-padding relative overflow-hidden">
  <!-- Background Grid -->
  <div class="absolute inset-0 neural-grid opacity-50"></div>

  <div class="container-custom relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        The <span class="text-gradient">Human-AI Symphony</span>
      </h2>
      <p class="text-xl text-text-secondary max-w-3xl mx-auto">
        Traditional development is too slow. We combine human creativity with AI precision to deliver impossible projects.
      </p>
    </div>

    <!-- Split Screen Visualization -->
    <div class="grid lg:grid-cols-3 gap-8 mb-16">
      <!-- Left: Human -->
      <div class="card-hover group animate-on-scroll" data-delay="100">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 rounded-full bg-accent/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-accent">Human</h3>
        </div>

        <p class="text-text-secondary mb-6">
          Traditional development is slow, complex, and expensive. Innovation waits.
        </p>

        <div class="space-y-3">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm">Strategy & Vision</span>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm">Creative Direction</span>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm">Taste & Judgment</span>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm">User Empathy</span>
          </div>
        </div>
      </div>

      <!-- Middle: Synthesis -->
      <div class="card-hover group animate-on-scroll relative" data-delay="200">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-accent/10 rounded-lg"></div>
        <div class="relative">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center">
              <svg class="w-6 h-6 text-void" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gradient">Synthesis</h3>
          </div>

          <p class="text-text-primary font-semibold mb-6">
            Human creativity + AI precision = Magic
          </p>

          <div class="space-y-4 text-center">
            <div class="text-6xl font-bold text-gradient">10x</div>
            <div class="text-lg text-text-secondary">Faster Development</div>

            <div class="grid grid-cols-2 gap-4 pt-4">
              <div>
                <div class="text-3xl font-bold text-primary">60%</div>
                <div class="text-xs text-text-tertiary">Time Saved</div>
              </div>
              <div>
                <div class="text-3xl font-bold text-accent">∞</div>
                <div class="text-xs text-text-tertiary">More Creative</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: AI -->
      <div class="card-hover group animate-on-scroll" data-delay="300">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 rounded-full bg-primary/20 flex items-center justify-center">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-primary">AI</h3>
        </div>

        <p class="text-text-secondary mb-6">
          We use AI to amplify human capabilities, delivering speed and scale without compromise.
        </p>

        <div class="space-y-3">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm">Generate 50 variations in seconds</span>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm">Write boilerplate code automatically</span>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm">Test across 100 scenarios simultaneously</span>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm">Optimize performance automatically</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom CTA -->
    <div class="text-center animate-on-scroll">
      <p class="text-lg text-text-secondary mb-6">
        AI amplifies. Humans direct.<br />
        <span class="text-primary font-semibold">Zero compromise on quality.</span>
      </p>
      <a href="#work" class="btn-primary inline-block">
        See What We've Built →
      </a>
    </div>
  </div>
</section>

<script>
  // Add staggered animation delays
  const elements = document.querySelectorAll('.animate-on-scroll[data-delay]');
  elements.forEach((el) => {
    const delay = el.getAttribute('data-delay');
    if (delay) {
      (el as HTMLElement).style.transitionDelay = `${parseInt(delay)}ms`;
    }
  });
</script>

<style>
  .animate-on-scroll[data-delay] {
    transition-delay: 0ms;
  }
</style>
