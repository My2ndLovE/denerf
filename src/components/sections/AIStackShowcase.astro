---
// AI Stack Section - "Data Flow Visualization"
---

<section id="ai-stack" class="section relative neural-grid">
  <div class="container-custom">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-5xl md:text-6xl font-bold mb-6 gradient-text">
        Our AI Arsenal
      </h2>
      <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto">
        Meet the AI collaborators that power our development process.
      </p>
    </div>

    <!-- AI Stack Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Claude -->
      <div class="ai-tool-card group" data-tool="claude">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-primary to-accent opacity-20 rounded-2xl blur-xl group-hover:opacity-40 transition-opacity duration-300"></div>
          <div class="relative glass rounded-2xl p-8">
            <div class="flex items-center justify-between mb-6">
              <div class="text-5xl">🧠</div>
              <div class="activity-indicator"></div>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-primary">Claude</h3>
            <p class="text-gray-300 mb-4">Architecture planning, code generation, and complex reasoning</p>
            <div class="flex flex-wrap gap-2">
              <span class="tag">Daily</span>
              <span class="tag">Core</span>
            </div>
            <div class="mt-6 text-sm text-gray-400">
              Use Case: Full-stack development, testing, documentation
            </div>
          </div>
        </div>
      </div>

      <!-- GPT-4 -->
      <div class="ai-tool-card group" data-tool="gpt4">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-accent to-coral opacity-20 rounded-2xl blur-xl group-hover:opacity-40 transition-opacity duration-300"></div>
          <div class="relative glass rounded-2xl p-8">
            <div class="flex items-center justify-between mb-6">
              <div class="text-5xl">⚡</div>
              <div class="activity-indicator"></div>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-accent">GPT-4</h3>
            <p class="text-gray-300 mb-4">Rapid prototyping, API integration, and data processing</p>
            <div class="flex flex-wrap gap-2">
              <span class="tag">Daily</span>
              <span class="tag">Versatile</span>
            </div>
            <div class="mt-6 text-sm text-gray-400">
              Use Case: Quick iterations, content generation, automation
            </div>
          </div>
        </div>
      </div>

      <!-- GitHub Copilot -->
      <div class="ai-tool-card group" data-tool="copilot">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-coral to-golden opacity-20 rounded-2xl blur-xl group-hover:opacity-40 transition-opacity duration-300"></div>
          <div class="relative glass rounded-2xl p-8">
            <div class="flex items-center justify-between mb-6">
              <div class="text-5xl">💻</div>
              <div class="activity-indicator"></div>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-coral">GitHub Copilot</h3>
            <p class="text-gray-300 mb-4">Real-time code suggestions and pair programming</p>
            <div class="flex flex-wrap gap-2">
              <span class="tag">Always On</span>
              <span class="tag">Essential</span>
            </div>
            <div class="mt-6 text-sm text-gray-400">
              Use Case: Inline code completion, boilerplate generation
            </div>
          </div>
        </div>
      </div>

      <!-- Midjourney -->
      <div class="ai-tool-card group" data-tool="midjourney">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-golden to-primary opacity-20 rounded-2xl blur-xl group-hover:opacity-40 transition-opacity duration-300"></div>
          <div class="relative glass rounded-2xl p-8">
            <div class="flex items-center justify-between mb-6">
              <div class="text-5xl">🎨</div>
              <div class="activity-indicator"></div>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-golden">Midjourney</h3>
            <p class="text-gray-300 mb-4">Design concept exploration and asset generation</p>
            <div class="flex flex-wrap gap-2">
              <span class="tag">Weekly</span>
              <span class="tag">Creative</span>
            </div>
            <div class="mt-6 text-sm text-gray-400">
              Use Case: UI mockups, branding, visual concepts
            </div>
          </div>
        </div>
      </div>

      <!-- Custom Models -->
      <div class="ai-tool-card group" data-tool="custom">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-primary to-coral opacity-20 rounded-2xl blur-xl group-hover:opacity-40 transition-opacity duration-300"></div>
          <div class="relative glass rounded-2xl p-8">
            <div class="flex items-center justify-between mb-6">
              <div class="text-5xl">🔬</div>
              <div class="activity-indicator"></div>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-primary">Custom Models</h3>
            <p class="text-gray-300 mb-4">Fine-tuned models for specific project needs</p>
            <div class="flex flex-wrap gap-2">
              <span class="tag">Project-Specific</span>
              <span class="tag">Advanced</span>
            </div>
            <div class="mt-6 text-sm text-gray-400">
              Use Case: Domain-specific tasks, optimization
            </div>
          </div>
        </div>
      </div>

      <!-- Automation -->
      <div class="ai-tool-card group" data-tool="automation">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-accent to-golden opacity-20 rounded-2xl blur-xl group-hover:opacity-40 transition-opacity duration-300"></div>
          <div class="relative glass rounded-2xl p-8">
            <div class="flex items-center justify-between mb-6">
              <div class="text-5xl">🤖</div>
              <div class="activity-indicator"></div>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-accent">AI Agents</h3>
            <p class="text-gray-300 mb-4">Automated testing, deployment, and monitoring</p>
            <div class="flex flex-wrap gap-2">
              <span class="tag">Continuous</span>
              <span class="tag">Ops</span>
            </div>
            <div class="mt-6 text-sm text-gray-400">
              Use Case: CI/CD, quality assurance, alerting
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Integration visualization -->
    <div class="mt-16 text-center">
      <p class="text-lg text-gray-300 mb-8">
        All tools integrated into a seamless workflow, creating a development environment
        that's <span class="text-primary font-bold">10x faster</span> and <span class="text-accent font-bold">infinitely more creative</span>.
      </p>
    </div>
  </div>
</section>

<script>
  // Pulse activity indicators
  const indicators = document.querySelectorAll('.activity-indicator');

  indicators.forEach((indicator, index) => {
    setInterval(() => {
      indicator.classList.add('pulse-active');
      setTimeout(() => {
        indicator.classList.remove('pulse-active');
      }, 1000);
    }, 2000 + index * 300); // Stagger the pulses
  });
</script>

<style>
  .ai-tool-card {
    transition: transform 0.3s ease;
  }

  .ai-tool-card:hover {
    transform: translateY(-8px);
  }

  .activity-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(0, 245, 255, 0.5);
    position: relative;
  }

  .activity-indicator::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid rgba(0, 245, 255, 0.3);
    opacity: 0;
  }

  .activity-indicator.pulse-active {
    background: rgba(0, 245, 255, 1);
  }

  .activity-indicator.pulse-active::before {
    animation: pulse-ring 1s ease-out;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .tag {
    @apply px-3 py-1 bg-primary-dim rounded-full text-xs text-primary;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-tool-card:hover {
      transform: none;
    }

    .activity-indicator.pulse-active::before {
      animation: none;
    }
  }
</style>
