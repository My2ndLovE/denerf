---
const techCategories = [
  {
    name: 'Frontend',
    color: '#00f5ff',
    technologies: [
      { name: 'React', proficiency: 5 },
      { name: 'Vue', proficiency: 4 },
      { name: 'Astro', proficiency: 5 },
      { name: 'Tailwind CSS', proficiency: 5 },
    ],
  },
  {
    name: 'Backend',
    color: '#bf40bf',
    technologies: [
      { name: 'Node.js', proficiency: 5 },
      { name: 'Python', proficiency: 4 },
      { name: 'Go', proficiency: 3 },
    ],
  },
  {
    name: 'Database',
    color: '#00f5ff',
    technologies: [
      { name: 'PostgreSQL', proficiency: 5 },
      { name: 'MongoDB', proficiency: 4 },
      { name: 'Redis', proficiency: 4 },
    ],
  },
  {
    name: 'Cloud & DevOps',
    color: '#bf40bf',
    technologies: [
      { name: 'AWS', proficiency: 4 },
      { name: 'Vercel', proficiency: 5 },
      { name: 'Docker', proficiency: 4 },
      { name: 'GitHub Actions', proficiency: 5 },
    ],
  },
  {
    name: 'Mobile',
    color: '#00f5ff',
    technologies: [
      { name: 'React Native', proficiency: 4 },
      { name: 'Flutter', proficiency: 3 },
    ],
  },
  {
    name: 'Design & Tools',
    color: '#bf40bf',
    technologies: [
      { name: 'Figma', proficiency: 5 },
      { name: 'Framer', proficiency: 4 },
      { name: 'Storybook', proficiency: 4 },
    ],
  },
];
---

<section id="tech-stack" class="section bg-gradient-to-b from-surface to-base">
  <div class="container max-w-6xl">
    <h2 class="text-section mb-6 text-center animate-on-scroll">
      Our <span class="gradient-text">Toolkit</span>
    </h2>

    <p class="text-xl text-text-muted text-center mb-16 max-w-3xl mx-auto animate-on-scroll">
      We believe in using the right tool for the job, not the trendy one.
    </p>

    <!-- Tech Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {techCategories.map((category, index) => (
        <div
          class="animate-on-scroll"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <div class="mb-4">
            <h3 class="text-2xl font-bold text-accent mb-2 flex items-center gap-2">
              <span
                class="w-3 h-3 rounded-full"
                style={`background-color: ${category.color}; box-shadow: 0 0 10px ${category.color}`}
              />
              {category.name}
            </h3>
          </div>

          <div class="space-y-3">
            {category.technologies.map((tech) => (
              <div class="group">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-text-primary group-hover:text-primary transition-colors">
                    {tech.name}
                  </span>
                  <div class="flex gap-1">
                    {[...Array(5)].map((_, i) => (
                      <div
                        class={`w-2 h-2 rounded-full transition-all ${
                          i < tech.proficiency
                            ? 'bg-primary group-hover:scale-110'
                            : 'bg-surface'
                        }`}
                        style={i < tech.proficiency ? `box-shadow: 0 0 8px ${category.color}` : ''}
                      />
                    ))}
                  </div>
                </div>

                {/* Progress bar */}
                <div class="h-1 bg-surface rounded-full overflow-hidden">
                  <div
                    class="h-full transition-all duration-500 rounded-full group-hover:w-full"
                    style={`
                      width: ${(tech.proficiency / 5) * 100}%;
                      background: linear-gradient(90deg, ${category.color}, ${category.color}80);
                      box-shadow: 0 0 10px ${category.color}40;
                    `}
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Why We Choose Section -->
    <div class="mt-16 pt-16 border-t border-primary/20 animate-on-scroll">
      <h3 class="text-3xl font-bold text-center mb-8 text-accent">
        How We Choose Our Stack
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="text-4xl mb-4">🎯</div>
          <h4 class="text-xl font-semibold mb-2 text-primary">Right for the Job</h4>
          <p class="text-text-muted">
            We don't use React for everything. Sometimes vanilla JS is perfect.
          </p>
        </div>

        <div class="text-center">
          <div class="text-4xl mb-4">⚡</div>
          <h4 class="text-xl font-semibold mb-2 text-primary">Performance First</h4>
          <p class="text-text-muted">
            If it adds 100KB to the bundle, it better save us 100 hours of work.
          </p>
        </div>

        <div class="text-center">
          <div class="text-4xl mb-4">🔮</div>
          <h4 class="text-xl font-semibold mb-2 text-primary">Future-Proof</h4>
          <p class="text-text-muted">
            We avoid bleeding-edge experiments. Your code should last years, not months.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Glow effect on hover */
  .group:hover .bg-primary {
    animation: pulse 1s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }
</style>
