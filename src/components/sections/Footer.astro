---
import companyData from '@/data/company.json';

const currentYear = new Date().getFullYear();
---

<footer class="footer-section py-12 px-4 border-t border-white/10">
  <div class="container mx-auto max-w-6xl">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Company Info -->
      <div>
        <h3 class="text-xl font-bold mb-3">{companyData.name}</h3>
        <p class="text-text-primary/70 text-sm mb-3">{companyData.tagline}</p>
        <p class="text-text-primary/70 text-sm">{companyData.mission}</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-semibold mb-3">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#hero" class="text-text-primary/70 hover:text-primary transition-colors">
              Home
            </a>
          </li>
          <li>
            <a href="#about" class="text-text-primary/70 hover:text-primary transition-colors">
              About
            </a>
          </li>
          <li>
            <a href="#services" class="text-text-primary/70 hover:text-primary transition-colors">
              Services
            </a>
          </li>
          <li>
            <a href="#portfolio" class="text-text-primary/70 hover:text-primary transition-colors">
              Portfolio
            </a>
          </li>
          <li>
            <a href="#contact" class="text-text-primary/70 hover:text-primary transition-colors">
              Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="font-semibold mb-3">Get In Touch</h4>
        <p class="text-text-primary/70 text-sm mb-2">
          Ready to start your project?
        </p>
        <a
          href="#contact"
          class="glass-button inline-block text-sm"
        >
          Contact Us
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="text-center pt-8 border-t border-white/10">
      <p class="text-text-primary/60 text-sm">
        © {currentYear} {companyData.name}. Built with ❤️ using Astro & React.
      </p>
    </div>
  </div>
</footer>
