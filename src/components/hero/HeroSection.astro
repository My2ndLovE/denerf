---
import MagneticButton from '../ui/MagneticButton.astro';
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Animated Blob Backgrounds -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <!-- Blob 1 -->
    <div
      class="blob absolute top-20 left-10 w-96 h-96 bg-electric-500/20 rounded-full"
      data-speed="0.5"
    >
    </div>
    <!-- Blob 2 -->
    <div
      class="blob absolute bottom-20 right-20 w-128 h-128 bg-neon-500/10 rounded-full"
      data-speed="0.7"
      style="animation-delay: -3s;"
    >
    </div>
    <!-- Blob 3 -->
    <div
      class="blob absolute top-1/2 left-1/3 w-64 h-64 bg-electric-500/15 rounded-full"
      data-speed="0.3"
      style="animation-delay: -5s;"
    >
    </div>
  </div>

  <!-- Main Content -->
  <div class="container-custom relative z-10">
    <div class="max-w-5xl mx-auto text-center">
      <!-- Eyebrow -->
      <div
        class="inline-block mb-24 px-24 py-8 glass rounded-full text-sm tracking-wider uppercase text-electric-500"
        data-animate="fade-in"
      >
        Performance-First Development
      </div>

      <!-- Main Heading with Split Text Animation -->
      <h1 class="text-5xl md:text-6xl lg:text-[5rem] font-bold mb-24 leading-tight">
        <span class="block mb-8" data-split-text data-animate="slide-up">
          We Build
          <span class="gradient-text">Lightning-Fast</span>
        </span>
        <span class="block" data-split-text data-animate="slide-up" data-delay="0.2">
          Digital Experiences
        </span>
      </h1>

      <!-- Description -->
      <p
        class="text-lg md:text-xl text-neutral-light/80 mb-48 max-w-3xl mx-auto leading-relaxed"
        data-animate="fade-in"
        data-delay="0.4"
      >
        Award-winning web development agency crafting high-performance websites that combine
        cutting-edge technology with unforgettable design. We don't just build sites—we create
        experiences that convert.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-16 justify-center items-center" data-animate="fade-in" data-delay="0.6">
        <MagneticButton href="#contact" variant="primary" size="large">
          Start Your Project
        </MagneticButton>
        <MagneticButton href="#portfolio" variant="secondary" size="large">
          View Our Work
        </MagneticButton>
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute bottom-32 left-1/2 -translate-x-1/2 scroll-indicator">
        <div class="flex flex-col items-center gap-8">
          <span class="text-sm text-neutral-light/60 uppercase tracking-wider">Scroll</span>
          <div class="w-6 h-10 rounded-full border-2 border-electric-500/30 flex justify-center p-2">
            <div class="w-1 h-3 bg-electric-500 rounded-full animate-bounce"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Gradient Overlay for depth -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-space-500 pointer-events-none"></div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Split text animation
  function splitText() {
    const elements = document.querySelectorAll('[data-split-text]');

    elements.forEach((element) => {
      const text = element.textContent || '';
      const words = text.trim().split(' ');

      element.innerHTML = words
        .map((word) => `<span class="split-text inline-block">${word}</span>`)
        .join(' ');

      const spans = element.querySelectorAll('.split-text');
      const delay = parseFloat(element.getAttribute('data-delay') || '0');

      gsap.from(spans, {
        y: 100,
        opacity: 0,
        duration: 0.8,
        stagger: 0.05,
        delay: delay,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: element,
          start: 'top 80%',
        },
      });
    });
  }

  // Fade in animations
  function fadeInAnimations() {
    const elements = document.querySelectorAll('[data-animate="fade-in"]');

    elements.forEach((element) => {
      const delay = parseFloat(element.getAttribute('data-delay') || '0');

      gsap.from(element, {
        opacity: 0,
        y: 30,
        duration: 1,
        delay: delay,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: element,
          start: 'top 80%',
        },
      });
    });
  }

  // Parallax effect on blobs
  function parallaxBlobs() {
    const blobs = document.querySelectorAll('.blob');

    blobs.forEach((blob) => {
      const speed = parseFloat(blob.getAttribute('data-speed') || '0.5');

      gsap.to(blob, {
        y: () => window.innerHeight * speed,
        ease: 'none',
        scrollTrigger: {
          trigger: '#hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
    });
  }

  // Initialize animations
  document.addEventListener('astro:page-load', () => {
    splitText();
    fadeInAnimations();
    parallaxBlobs();
  });
</script>

<style>
  /* Scroll indicator pulse animation */
  .scroll-indicator {
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>
