---
// Portfolio Section with Masonry Grid
const projects = [
  {
    id: 1,
    title: "Quantum Commerce",
    category: "E-commerce",
    description: "Next-gen e-commerce platform with AR product visualization",
    image: "/projects/quantum.jpg",
    tech: ["Next.js", "Three.js", "Stripe"],
    metrics: { performance: 98, conversion: "+45%" },
    size: "large"
  },
  {
    id: 2,
    title: "Neural Dashboard",
    category: "SaaS",
    description: "Real-time analytics dashboard for ML models",
    image: "/projects/neural.jpg",
    tech: ["React", "D3.js", "WebSockets"],
    metrics: { performance: 96, users: "50K+" },
    size: "medium"
  },
  {
    id: 3,
    title: "Zen Finance",
    category: "Fintech",
    description: "Minimalist personal finance tracker",
    image: "/projects/zen.jpg",
    tech: ["Astro", "PostgreSQL", "Plaid"],
    metrics: { performance: 99, loadTime: "0.8s" },
    size: "medium"
  },
  {
    id: 4,
    title: "Creative Studio Portfolio",
    category: "Agency",
    description: "Award-winning portfolio for design agency",
    image: "/projects/studio.jpg",
    tech: ["Astro", "GSAP", "Three.js"],
    metrics: { performance: 97, awards: 3 },
    size: "large"
  },
  {
    id: 5,
    title: "FitTrack Pro",
    category: "Health",
    description: "AI-powered fitness tracking app",
    image: "/projects/fittrack.jpg",
    tech: ["React Native", "TensorFlow", "Firebase"],
    metrics: { performance: 95, downloads: "100K+" },
    size: "medium"
  },
  {
    id: 6,
    title: "BookHaven",
    category: "E-commerce",
    description: "Modern online bookstore with community features",
    image: "/projects/bookhaven.jpg",
    tech: ["Next.js", "Prisma", "Stripe"],
    metrics: { performance: 96, growth: "+120%" },
    size: "small"
  }
];
---

<section id="portfolio" class="portfolio-section section relative">
  <div class="container">
    <!-- Section Label -->
    <div class="section-label mb-16 text-center">
      <span class="font-mono text-sm tracking-widest text-brand-cyan">[ 04 ]</span>
      <h2 class="text-5xl md:text-6xl lg:text-7xl font-display font-bold mt-4 mb-6">
        Selected Work
      </h2>
      <p class="text-xl text-white/60 max-w-2xl mx-auto">
        Projects that pushed boundaries and delivered results.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="portfolio-filters mb-12">
      <button class="filter-btn active" data-filter="all">All Projects</button>
      <button class="filter-btn" data-filter="E-commerce">E-commerce</button>
      <button class="filter-btn" data-filter="SaaS">SaaS</button>
      <button class="filter-btn" data-filter="Fintech">Fintech</button>
      <button class="filter-btn" data-filter="Agency">Agency</button>
    </div>

    <!-- Masonry Grid -->
    <div class="portfolio-grid">
      {projects.map((project) => (
        <article
          class={`project-card ${project.size}`}
          data-category={project.category}
          data-project-id={project.id}
        >
          <div class="project-image-container">
            <!-- Placeholder gradient instead of actual image -->
            <div class="project-image-placeholder" style={`background: linear-gradient(135deg, var(--color-brand-purple) 0%, var(--color-brand-cyan) 100%);`}></div>
            <div class="project-overlay">
              <div class="project-overlay-content">
                <span class="view-project-btn">View Project →</span>
              </div>
            </div>
          </div>

          <div class="project-info">
            <div class="project-meta">
              <span class="project-category">{project.category}</span>
              <span class="project-performance">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M8 2L10 6L14 7L11 10L12 14L8 12L4 14L5 10L2 7L6 6L8 2Z" fill="currentColor" class="text-brand-cyan"/>
                </svg>
                {project.metrics.performance}
              </span>
            </div>

            <h3 class="project-title">{project.title}</h3>
            <p class="project-description">{project.description}</p>

            <div class="project-tech">
              {project.tech.map((tech) => (
                <span class="tech-badge">{tech}</span>
              ))}
            </div>

            <div class="project-metrics">
              {Object.entries(project.metrics).slice(1).map(([key, value]) => (
                <div class="metric-item">
                  <span class="metric-label">{key}</span>
                  <span class="metric-value">{value}</span>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- View All CTA -->
    <div class="portfolio-cta text-center mt-16">
      <a href="/portfolio" class="btn-primary magnetic">
        View All Projects
        <span class="btn-arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .portfolio-section {
    background: var(--color-brand-black);
    padding: clamp(6rem, 15vw, 12rem) 0;
  }

  /* Filters */
  .portfolio-filters {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    padding: 0.75rem 1.5rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all var(--duration-base) var(--ease-out);
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: var(--color-brand-cyan);
    border-color: var(--color-brand-cyan);
    color: var(--color-brand-black);
  }

  /* Masonry Grid */
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .project-card {
    position: relative;
    background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    cursor: pointer;
    transition: all var(--duration-slow) var(--ease-out);
    opacity: 0;
    transform: translateY(30px);
  }

  .project-card.large {
    grid-column: span 8;
  }

  .project-card.medium {
    grid-column: span 6;
  }

  .project-card.small {
    grid-column: span 4;
  }

  .project-card:hover {
    border-color: var(--color-brand-cyan);
    transform: translateY(-10px);
  }

  .project-card.hidden {
    display: none;
  }

  /* Project Image */
  .project-image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .project-image-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .project-card:hover .project-image-placeholder {
    transform: scale(1.1);
  }

  /* Overlay */
  .project-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .view-project-btn {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-brand-cyan);
    padding: 1rem 2rem;
    border: 2px solid var(--color-brand-cyan);
    transition: all var(--duration-base) var(--ease-out);
  }

  .view-project-btn:hover {
    background: var(--color-brand-cyan);
    color: var(--color-brand-black);
  }

  /* Project Info */
  .project-info {
    padding: 2rem;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .project-category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-brand-purple);
  }

  .project-performance {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-brand-cyan);
  }

  .project-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-brand-white);
  }

  .project-description {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1.5rem;
  }

  /* Tech Badges */
  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tech-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.375rem 0.75rem;
    background: rgba(0, 240, 255, 0.1);
    border: 1px solid rgba(0, 240, 255, 0.3);
    border-radius: var(--radius-full);
    color: var(--color-brand-cyan);
  }

  /* Metrics */
  .project-metrics {
    display: flex;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.4);
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-brand-white);
  }

  /* CTA Button */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 2.5rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    background: var(--color-brand-cyan);
    color: var(--color-brand-black);
    border: 2px solid var(--color-brand-cyan);
    transition: all var(--duration-base) var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: var(--color-brand-purple);
    transition: left var(--duration-base) var(--ease-out);
    z-index: 0;
  }

  .btn-primary:hover::before {
    left: 0;
  }

  .btn-primary span {
    position: relative;
    z-index: 1;
  }

  .btn-arrow {
    transition: transform var(--duration-base) var(--ease-bounce);
  }

  .btn-primary:hover .btn-arrow {
    transform: translateX(5px);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .project-card.large,
    .project-card.medium {
      grid-column: span 6;
    }

    .project-card.small {
      grid-column: span 6;
    }
  }

  @media (max-width: 640px) {
    .project-card {
      grid-column: span 12 !important;
    }

    .project-info {
      padding: 1.5rem;
    }

    .project-metrics {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('astro:page-load', () => {
    // Filter functionality
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active button
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Filter projects
        projectCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.classList.remove('hidden');
            gsap.to(card, {
              opacity: 1,
              y: 0,
              duration: 0.6,
              ease: 'power2.out'
            });
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    // Animate cards on scroll
    projectCards.forEach((card, index) => {
      gsap.to(card, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        delay: index * 0.1,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '.portfolio-grid',
          start: 'top 70%',
          toggleActions: 'play none none none'
        }
      });
    });

    // Parallax effect
    projectCards.forEach((card, index) => {
      const image = card.querySelector('.project-image-placeholder');
      if (image) {
        gsap.to(image, {
          y: -30,
          scrollTrigger: {
            trigger: card,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1
          }
        });
      }
    });
  });
</script>
