---
const projects = [
  {
    id: 'ecommerce',
    name: 'E-commerce Rescue',
    industry: 'Retail',
    metricBefore: '2.1% conversion',
    metricAfter: '8.7% conversion',
    improvement: '314% increase',
    description: 'Transformed a cluttered checkout into a streamlined experience.',
    tech: ['React', 'Next.js', 'Stripe', 'Tailwind'],
    featured: true,
  },
  {
    id: 'dashboard',
    name: 'Enterprise Dashboard',
    industry: 'SaaS',
    metricBefore: 'Excel chaos',
    metricAfter: 'Real-time clarity',
    improvement: '10x faster insights',
    description: 'Replaced spreadsheet hell with an intuitive data visualization platform.',
    tech: ['Vue', 'D3.js', 'Node.js', 'PostgreSQL'],
    featured: true,
  },
  {
    id: 'mobile',
    name: 'Mobile App Redesign',
    industry: 'FinTech',
    metricBefore: '50% bounce rate',
    metricAfter: '12% bounce rate',
    improvement: '76% reduction',
    description: 'Simplified complex financial workflows into tap-friendly experiences.',
    tech: ['React Native', 'TypeScript', 'Firebase'],
    featured: false,
  },
  {
    id: 'api',
    name: 'Developer Platform',
    industry: 'API',
    metricBefore: '3 days onboarding',
    metricAfter: '3 hours onboarding',
    improvement: '24x faster',
    description: 'Built documentation that developers actually want to read.',
    tech: ['Astro', 'MDX', 'Algolia', 'Vercel'],
    featured: false,
  },
];
---

<section id="portfolio" class="section bg-base">
  <div class="container max-w-7xl">
    <h2 class="text-section mb-6 text-center animate-on-scroll">
      The <span class="gradient-text">Transformation</span> Gallery
    </h2>

    <p class="text-xl text-text-muted text-center mb-16 max-w-3xl mx-auto animate-on-scroll">
      We don't just build features. We solve problems. Here's the proof.
    </p>

    <!-- Masonry Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, index) => (
        <article
          class={`card group cursor-pointer ${
            project.featured ? 'md:col-span-2 lg:col-span-2' : ''
          } animate-on-scroll`}
          style={`animation-delay: ${index * 0.1}s`}
          data-project={project.id}
        >
          {/* Visual Placeholder */}
          <div class={`relative overflow-hidden rounded-lg mb-4 bg-gradient-to-br from-primary/20 to-secondary/20 ${
            project.featured ? 'h-80' : 'h-64'
          }`}>
            {/* Before/After Indicator */}
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center">
                <div class="text-5xl mb-4 opacity-50 group-hover:opacity-100 transition-opacity">
                  ↔️
                </div>
                <p class="text-sm text-text-muted">Click to see transformation</p>
              </div>
            </div>

            {/* Hover Overlay */}
            <div class="absolute inset-0 bg-gradient-to-t from-base/90 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 flex items-end p-6">
              <div>
                <p class="text-sm font-semibold text-primary mb-2">{project.industry}</p>
                <div class="flex flex-wrap gap-2">
                  {project.tech.map((tech) => (
                    <span class="px-2 py-1 text-xs bg-surface rounded-full text-text-muted">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>

          {/* Content */}
          <h3 class="text-2xl font-bold mb-2 text-accent group-hover:text-primary transition-colors">
            {project.name}
          </h3>

          <p class="text-text-muted mb-4">
            {project.description}
          </p>

          {/* Metrics */}
          <div class="flex items-center justify-between text-sm">
            <div>
              <p class="text-text-muted line-through">{project.metricBefore}</p>
              <p class="text-primary font-semibold">{project.metricAfter}</p>
            </div>
            <div class="text-right">
              <p class="text-accent font-bold">{project.improvement}</p>
            </div>
          </div>

          {/* CTA */}
          <div class="mt-4 pt-4 border-t border-primary/20">
            <span class="text-primary text-sm font-semibold group-hover:underline inline-flex items-center gap-2">
              View Case Study
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </article>
      ))}
    </div>

    <!-- Note about interactivity -->
    <div class="mt-12 text-center">
      <p class="text-sm text-text-muted italic">
        Interactive before/after sliders coming soon - click any project to learn more
      </p>
    </div>
  </div>
</section>

<style>
  /* Masonry-like layout for featured items */
  @media (min-width: 768px) {
    .grid > article:nth-child(1) {
      grid-row: span 1;
    }
  }
</style>
