---
// Portfolio Section - Adaptive Grid with AI Projects
---

<section id="portfolio" class="section relative">
  <div class="container-custom">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-5xl md:text-6xl font-bold mb-6 gradient-text">
        Built With AI
      </h2>
      <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto">
        Real projects. Real impact. Real AI augmentation.
      </p>
    </div>

    <!-- Filter buttons -->
    <div class="flex flex-wrap justify-center gap-4 mb-12">
      <button class="filter-btn active" data-filter="all">All Projects</button>
      <button class="filter-btn" data-filter="ai-generated">AI-Generated</button>
      <button class="filter-btn" data-filter="ai-assisted">AI-Assisted</button>
      <button class="filter-btn" data-filter="ai-optimized">AI-Optimized</button>
    </div>

    <!-- Portfolio grid -->
    <div id="portfolio-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Project cards -->
      <article class="portfolio-card group" data-category="ai-generated">
        <div class="relative overflow-hidden rounded-2xl aspect-video bg-gradient-to-br from-primary-dim to-accent-dim">
          <div class="absolute inset-0 bg-surface opacity-90 group-hover:opacity-0 transition-opacity duration-500"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="text-6xl">🎨</span>
          </div>
        </div>
        <div class="mt-6">
          <h3 class="text-2xl font-bold mb-2 text-primary">Neural Art Gallery</h3>
          <p class="text-gray-300 mb-4">AI-generated artwork marketplace with real-time style transfer</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-primary-dim rounded-full text-xs">Midjourney</span>
            <span class="px-3 py-1 bg-accent-dim rounded-full text-xs">GPT-4</span>
            <span class="px-3 py-1 bg-golden/20 rounded-full text-xs">50% faster</span>
          </div>
        </div>
      </article>

      <article class="portfolio-card group" data-category="ai-assisted">
        <div class="relative overflow-hidden rounded-2xl aspect-video bg-gradient-to-br from-accent-dim to-coral/20">
          <div class="absolute inset-0 bg-surface opacity-90 group-hover:opacity-0 transition-opacity duration-500"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="text-6xl">📊</span>
          </div>
        </div>
        <div class="mt-6">
          <h3 class="text-2xl font-bold mb-2 text-accent">Analytics Dashboard</h3>
          <p class="text-gray-300 mb-4">Real-time data visualization with AI-powered insights</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-primary-dim rounded-full text-xs">Claude</span>
            <span class="px-3 py-1 bg-accent-dim rounded-full text-xs">Three.js</span>
            <span class="px-3 py-1 bg-golden/20 rounded-full text-xs">10x faster</span>
          </div>
        </div>
      </article>

      <article class="portfolio-card group" data-category="ai-optimized">
        <div class="relative overflow-hidden rounded-2xl aspect-video bg-gradient-to-br from-coral/20 to-primary-dim">
          <div class="absolute inset-0 bg-surface opacity-90 group-hover:opacity-0 transition-opacity duration-500"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="text-6xl">🤖</span>
          </div>
        </div>
        <div class="mt-6">
          <h3 class="text-2xl font-bold mb-2 text-coral">AI Chatbot Platform</h3>
          <p class="text-gray-300 mb-4">Conversational AI with custom training and analytics</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-primary-dim rounded-full text-xs">Claude</span>
            <span class="px-3 py-1 bg-accent-dim rounded-full text-xs">GPT-4</span>
            <span class="px-3 py-1 bg-golden/20 rounded-full text-xs">70% cost reduction</span>
          </div>
        </div>
      </article>

      <article class="portfolio-card group" data-category="ai-generated">
        <div class="relative overflow-hidden rounded-2xl aspect-video bg-gradient-to-br from-primary-dim to-golden/20">
          <div class="absolute inset-0 bg-surface opacity-90 group-hover:opacity-0 transition-opacity duration-500"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="text-6xl">🎵</span>
          </div>
        </div>
        <div class="mt-6">
          <h3 class="text-2xl font-bold mb-2 text-golden">Music Gen Studio</h3>
          <p class="text-gray-300 mb-4">AI-powered music generation and remixing platform</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-primary-dim rounded-full text-xs">Custom Models</span>
            <span class="px-3 py-1 bg-accent-dim rounded-full text-xs">WebAudio</span>
            <span class="px-3 py-1 bg-golden/20 rounded-full text-xs">Revolutionary</span>
          </div>
        </div>
      </article>

      <article class="portfolio-card group" data-category="ai-assisted">
        <div class="relative overflow-hidden rounded-2xl aspect-video bg-gradient-to-br from-accent-dim to-primary-dim">
          <div class="absolute inset-0 bg-surface opacity-90 group-hover:opacity-0 transition-opacity duration-500"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="text-6xl">🏗️</span>
          </div>
        </div>
        <div class="mt-6">
          <h3 class="text-2xl font-bold mb-2 text-primary">Design System Builder</h3>
          <p class="text-gray-300 mb-4">AI-assisted design system generation from screenshots</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-primary-dim rounded-full text-xs">Claude Vision</span>
            <span class="px-3 py-1 bg-accent-dim rounded-full text-xs">Figma API</span>
            <span class="px-3 py-1 bg-golden/20 rounded-full text-xs">95% accuracy</span>
          </div>
        </div>
      </article>

      <article class="portfolio-card group" data-category="ai-optimized">
        <div class="relative overflow-hidden rounded-2xl aspect-video bg-gradient-to-br from-coral/20 to-accent-dim">
          <div class="absolute inset-0 bg-surface opacity-90 group-hover:opacity-0 transition-opacity duration-500"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="text-6xl">⚡</span>
          </div>
        </div>
        <div class="mt-6">
          <h3 class="text-2xl font-bold mb-2 text-accent">Performance Optimizer</h3>
          <p class="text-gray-300 mb-4">AI-driven code optimization and bundle analysis</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-primary-dim rounded-full text-xs">GPT-4</span>
            <span class="px-3 py-1 bg-accent-dim rounded-full text-xs">Webpack</span>
            <span class="px-3 py-1 bg-golden/20 rounded-full text-xs">40% faster loads</span>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.portfolio-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update active state
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Filter cards
      cards.forEach(card => {
        const category = card.getAttribute('data-category');

        if (filter === 'all' || category === filter) {
          card.style.display = 'block';
          setTimeout(() => {
            card.classList.add('show');
          }, 100);
        } else {
          card.classList.remove('show');
          setTimeout(() => {
            card.style.display = 'none';
          }, 300);
        }
      });
    });
  });

  // Initialize all cards as shown
  cards.forEach(card => card.classList.add('show'));
</script>

<style>
  .filter-btn {
    @apply px-6 py-3 rounded-full border-2 border-primary-dim text-primary transition-all duration-300;
  }

  .filter-btn:hover {
    @apply border-primary bg-primary-dim;
  }

  .filter-btn.active {
    @apply bg-primary text-void border-primary;
  }

  .portfolio-card {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.3s, transform 0.3s;
  }

  .portfolio-card.show {
    opacity: 1;
    transform: translateY(0);
  }

  .portfolio-card:hover {
    transform: translateY(-8px);
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-card {
      opacity: 1;
      transform: none;
    }

    .portfolio-card:hover {
      transform: none;
    }
  }
</style>
