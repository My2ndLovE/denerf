---
// Chapter 2: THE COLLABORATION - "Split Screen Reality"
// Human + AI collaboration visualized with dynamic merging
---

<section
  id="process"
  class="section min-h-screen relative"
  aria-label="Process - The Collaboration"
>
  <div class="container">
    <h2 class="text-5xl font-bold text-center mb-24 text-gradient">
      Human + AI Symphony
    </h2>

    <!-- Split Screen Container -->
    <div class="split-container grid md:grid-cols-3 gap-8 items-center">
      <!-- Left: Human Creativity -->
      <div class="human-side glass p-8 rounded-lg" data-side="human">
        <div class="w-16 h-16 mb-6 text-accent">
          <!-- Human Icon SVG -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="8" r="4"/>
            <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
          </svg>
        </div>
        <h3 class="text-2xl font-semibold mb-4">Human Creativity</h3>
        <p class="text-text-secondary mb-6">
          Strategic thinking, user empathy, brand vision, creative direction
        </p>
        <ul class="space-y-3 text-sm text-text-tertiary">
          <li class="flex items-start gap-2">
            <span class="text-success">✓</span>
            <span>Understanding user needs</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-success">✓</span>
            <span>Making strategic decisions</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-success">✓</span>
            <span>Defining brand identity</span>
          </li>
        </ul>
      </div>

      <!-- Center: Synthesis Zone -->
      <div class="synthesis-zone text-center relative">
        <div class="relative h-64 flex items-center justify-center">
          <!-- Animated synthesis visual (particles/connections) -->
          <div id="synthesis-canvas" class="absolute inset-0" aria-hidden="true"></div>
          <div class="relative z-10">
            <div class="text-6xl mb-4">⚡</div>
            <p class="text-xl font-semibold text-primary">Magic Happens Here</p>
          </div>
        </div>
      </div>

      <!-- Right: AI Precision -->
      <div class="ai-side glass p-8 rounded-lg" data-side="ai">
        <div class="w-16 h-16 mb-6 text-primary">
          <!-- AI Icon SVG -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>
        <h3 class="text-2xl font-semibold mb-4">AI Precision</h3>
        <p class="text-text-secondary mb-6">
          Code generation, rapid iteration, pattern recognition, tireless execution
        </p>
        <ul class="space-y-3 text-sm text-text-tertiary">
          <li class="flex items-start gap-2">
            <span class="text-primary">✓</span>
            <span>Generating 50+ variations instantly</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-primary">✓</span>
            <span>Writing boilerplate at light speed</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-primary">✓</span>
            <span>Catching edge cases and bugs</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Process Steps -->
    <div class="mt-32 grid md:grid-cols-4 gap-8">
      <div class="process-step text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-elevated flex items-center justify-center text-xl font-bold">
          1
        </div>
        <h4 class="text-lg font-semibold mb-2">The Challenge</h4>
        <p class="text-sm text-text-tertiary">Traditional development is too slow</p>
      </div>
      <div class="process-step text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-elevated flex items-center justify-center text-xl font-bold">
          2
        </div>
        <h4 class="text-lg font-semibold mb-2">AI Advantage</h4>
        <p class="text-sm text-text-tertiary">Generate 50 variations in seconds</p>
      </div>
      <div class="process-step text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-elevated flex items-center justify-center text-xl font-bold">
          3
        </div>
        <h4 class="text-lg font-semibold mb-2">Human Touch</h4>
        <p class="text-sm text-text-tertiary">AI amplifies, humans direct</p>
      </div>
      <div class="process-step text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-elevated flex items-center justify-center text-xl font-bold">
          4
        </div>
        <h4 class="text-lg font-semibold mb-2">The Result</h4>
        <p class="text-sm text-text-tertiary">10x faster, infinitely creative</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initProcessAnimation } from '../../scripts/animations/process.ts';
  document.addEventListener('DOMContentLoaded', () => {
    initProcessAnimation();
  });
</script>
