---
// CTA Section with Split Hero and Animated Form
---

<section id="contact" class="cta-section section relative overflow-hidden">
  <!-- Animated Background Blob -->
  <div class="cta-blob-bg">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
  </div>

  <div class="container relative z-10">
    <div class="cta-grid">
      <!-- Left: CTA Copy -->
      <div class="cta-content">
        <span class="font-mono text-sm tracking-widest text-brand-cyan mb-6 block">[ 05 ]</span>

        <h2 class="cta-title">
          Let's Build<br/>
          Something<br/>
          <span class="text-gradient">Exceptional</span>
        </h2>

        <p class="cta-description">
          Ready to create a digital experience that stands out?
          Let's talk about your project and how we can bring it to life.
        </p>

        <div class="cta-features">
          <div class="feature-item">
            <svg class="feature-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span>Free initial consultation</span>
          </div>

          <div class="feature-item">
            <svg class="feature-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span>Flexible engagement models</span>
          </div>

          <div class="feature-item">
            <svg class="feature-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span>Response within 24 hours</span>
          </div>
        </div>

        <!-- Social Links -->
        <div class="social-links">
          <a href="https://twitter.com" class="social-link magnetic" aria-label="Twitter">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/>
            </svg>
          </a>
          <a href="https://github.com" class="social-link magnetic" aria-label="GitHub">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a href="https://linkedin.com" class="social-link magnetic" aria-label="LinkedIn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: Contact Form -->
      <div class="cta-form-container">
        <form class="contact-form" id="contact-form">
          <div class="form-group">
            <label for="name" class="form-label">Your Name</label>
            <input
              type="text"
              id="name"
              name="name"
              class="form-input"
              placeholder="John Doe"
              required
            />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Email Address</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-input"
              placeholder="john@example.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="project" class="form-label">Project Type</label>
            <select id="project" name="project" class="form-input">
              <option value="">Select a project type</option>
              <option value="web">Web Development</option>
              <option value="design">UI/UX Design</option>
              <option value="ecommerce">E-commerce</option>
              <option value="animation">Animation & Motion</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="budget" class="form-label">Budget Range</label>
            <select id="budget" name="budget" class="form-input">
              <option value="">Select a budget range</option>
              <option value="5-10k">$5K - $10K</option>
              <option value="10-25k">$10K - $25K</option>
              <option value="25-50k">$25K - $50K</option>
              <option value="50k+">$50K+</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message" class="form-label">Tell Us About Your Project</label>
            <textarea
              id="message"
              name="message"
              class="form-input form-textarea"
              placeholder="What are you looking to build?"
              rows="5"
              required
            ></textarea>
          </div>

          <button type="submit" class="form-submit magnetic">
            <span class="submit-text">Send Message</span>
            <span class="submit-arrow">→</span>
            <span class="submit-loading">
              <svg class="spinner" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" opacity="0.25"/>
                <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
              </svg>
            </span>
          </button>

          <p class="form-message"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-left">
        <p class="footer-logo">Denerf</p>
        <p class="footer-tagline">Building the future, one pixel at a time.</p>
      </div>

      <div class="footer-right">
        <p class="footer-copyright">
          © {new Date().getFullYear()} Denerf. All rights reserved.
        </p>
        <p class="footer-credit">
          Crafted with <span class="text-brand-cyan">♥</span> using Astro
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .cta-section {
    background: var(--color-brand-black);
    padding: clamp(8rem, 15vw, 14rem) 0 4rem;
    position: relative;
  }

  /* Animated Blobs */
  .cta-blob-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    animation: blob 10s ease-in-out infinite;
  }

  .blob-1 {
    width: 400px;
    height: 400px;
    background: var(--color-brand-purple);
    top: 10%;
    left: 10%;
    animation-delay: 0s;
  }

  .blob-2 {
    width: 500px;
    height: 500px;
    background: var(--color-brand-cyan);
    bottom: 10%;
    right: 10%;
    animation-delay: 5s;
  }

  /* Grid Layout */
  .cta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  /* CTA Content */
  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }

  .cta-description {
    font-size: 1.25rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 3rem;
    max-width: 500px;
  }

  .cta-features {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .feature-icon {
    color: var(--color-brand-cyan);
    flex-shrink: 0;
  }

  /* Social Links */
  .social-links {
    display: flex;
    gap: 1.5rem;
  }

  .social-link {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.6);
    transition: all var(--duration-base) var(--ease-out);
  }

  .social-link:hover {
    border-color: var(--color-brand-cyan);
    color: var(--color-brand-cyan);
    transform: translateY(-3px);
  }

  /* Contact Form */
  .cta-form-container {
    background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 3rem;
    backdrop-filter: blur(10px);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.7);
  }

  .form-input,
  .form-textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 1rem 1.25rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-brand-white);
    outline: none;
    transition: all var(--duration-base) var(--ease-out);
  }

  .form-input:focus,
  .form-textarea:focus {
    border-color: var(--color-brand-cyan);
    box-shadow: 0 0 0 3px rgba(0, 240, 255, 0.1);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  /* Submit Button */
  .form-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.25rem 2rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    background: var(--color-brand-cyan);
    color: var(--color-brand-black);
    border: none;
    cursor: pointer;
    transition: all var(--duration-base) var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  .form-submit::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: var(--color-brand-purple);
    transition: left var(--duration-base) var(--ease-out);
  }

  .form-submit:hover::before {
    left: 0;
  }

  .submit-text,
  .submit-arrow {
    position: relative;
    z-index: 1;
  }

  .submit-arrow {
    transition: transform var(--duration-base) var(--ease-bounce);
  }

  .form-submit:hover .submit-arrow {
    transform: translateX(5px);
  }

  .submit-loading {
    display: none;
    position: relative;
    z-index: 1;
  }

  .form-submit.loading .submit-text,
  .form-submit.loading .submit-arrow {
    display: none;
  }

  .form-submit.loading .submit-loading {
    display: block;
  }

  .spinner {
    width: 24px;
    height: 24px;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .form-message {
    font-size: 0.875rem;
    text-align: center;
    margin-top: 0.5rem;
  }

  .form-message.success {
    color: var(--color-brand-cyan);
  }

  .form-message.error {
    color: #ff4444;
  }

  /* Footer */
  .footer {
    background: var(--color-brand-black);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 3rem 0;
    margin-top: 4rem;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-brand-cyan);
    margin-bottom: 0.5rem;
  }

  .footer-tagline {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.875rem;
  }

  .footer-right {
    text-align: right;
  }

  .footer-copyright,
  .footer-credit {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.875rem;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .cta-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .cta-form-container {
      padding: 2rem;
    }

    .footer-content {
      flex-direction: column;
      gap: 2rem;
      text-align: center;
    }

    .footer-right {
      text-align: center;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = form?.querySelector('.form-submit') as HTMLButtonElement;
    const message = form?.querySelector('.form-message') as HTMLParagraphElement;

    // Form animation on focus
    const inputs = form?.querySelectorAll('.form-input, .form-textarea');
    inputs?.forEach(input => {
      input.addEventListener('focus', (e) => {
        const target = e.target as HTMLElement;
        gsap.to(target, {
          scale: 1.02,
          duration: 0.2,
          ease: 'power2.out'
        });

        // Pulse blob on interaction
        const blobs = document.querySelectorAll('.blob');
        blobs.forEach(blob => {
          gsap.to(blob, {
            scale: 1.1,
            duration: 0.5,
            ease: 'power2.out',
            yoyo: true,
            repeat: 1
          });
        });
      });

      input.addEventListener('blur', (e) => {
        const target = e.target as HTMLElement;
        gsap.to(target, {
          scale: 1,
          duration: 0.2,
          ease: 'power2.out'
        });
      });
    });

    // Form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitBtn.classList.add('loading');
      message.textContent = '';

      // Simulate API call (replace with actual implementation)
      setTimeout(() => {
        submitBtn.classList.remove('loading');
        message.textContent = 'Thanks! We\'ll be in touch within 24 hours.';
        message.classList.add('success');
        form.reset();

        // Celebrate with animation
        gsap.to('.blob', {
          scale: 1.5,
          duration: 0.5,
          ease: 'elastic.out(1, 0.3)',
          yoyo: true,
          repeat: 1
        });
      }, 2000);
    });
  });
</script>
