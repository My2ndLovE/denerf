---
// Services section with Bento grid layout
---

<section id="services" class="relative section-padding bg-space-500">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="max-w-3xl mb-96">
      <h2 class="text-4xl md:text-5xl font-bold mb-24" data-animate="slide-up">
        What We <span class="gradient-text">Create</span>
      </h2>
      <p class="text-xl text-neutral-light/70 leading-relaxed" data-animate="fade-in" data-delay="0.2">
        From concept to deployment, we craft digital experiences that perform as beautifully as they
        look.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="bento-grid grid grid-cols-1 md:grid-cols-6 lg:grid-cols-12 gap-16 md:gap-24">
      <!-- Service 1 - Large -->
      <div
        class="service-card md:col-span-6 lg:col-span-8 glass p-32 md:p-48 rounded-3xl group hover:border-electric-500/50 border border-transparent transition-all duration-500"
        data-tilt
      >
        <div class="flex flex-col h-full justify-between min-h-[400px]">
          <div>
            <div
              class="w-64 h-64 mb-24 bg-electric-500/10 rounded-2xl flex items-center justify-center group-hover:bg-electric-500/20 transition-all duration-300"
            >
              <svg class="w-32 h-32 text-electric-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-3xl font-bold mb-16 group-hover:text-electric-500 transition-colors">
              High-Performance Web Apps
            </h3>
            <p class="text-neutral-light/70 leading-relaxed mb-24">
              Lightning-fast web applications built with modern frameworks like Astro, Next.js, and
              React. We optimize every byte for performance without sacrificing user experience.
            </p>
          </div>
          <div class="flex flex-wrap gap-8">
            <span class="text-xs px-12 py-4 bg-electric-500/10 text-electric-500 rounded-full">
              Astro
            </span>
            <span class="text-xs px-12 py-4 bg-electric-500/10 text-electric-500 rounded-full">
              Next.js
            </span>
            <span class="text-xs px-12 py-4 bg-electric-500/10 text-electric-500 rounded-full">
              React
            </span>
            <span class="text-xs px-12 py-4 bg-electric-500/10 text-electric-500 rounded-full">
              TypeScript
            </span>
          </div>
        </div>
      </div>

      <!-- Service 2 - Medium -->
      <div
        class="service-card md:col-span-6 lg:col-span-4 glass p-32 rounded-3xl group hover:border-neon-500/50 border border-transparent transition-all duration-500"
        data-tilt
      >
        <div class="flex flex-col h-full justify-between min-h-[400px]">
          <div>
            <div
              class="w-64 h-64 mb-24 bg-neon-500/10 rounded-2xl flex items-center justify-center group-hover:bg-neon-500/20 transition-all duration-300"
            >
              <svg class="w-32 h-32 text-neon-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-16 group-hover:text-neon-500 transition-colors">
              UI/UX Design
            </h3>
            <p class="text-neutral-light/70 leading-relaxed">
              Interfaces that users love. We combine psychology, aesthetics, and data to create
              designs that convert.
            </p>
          </div>
          <div class="flex flex-wrap gap-8 mt-24">
            <span class="text-xs px-12 py-4 bg-neon-500/10 text-neon-500 rounded-full">Figma</span>
            <span class="text-xs px-12 py-4 bg-neon-500/10 text-neon-500 rounded-full">
              Design Systems
            </span>
          </div>
        </div>
      </div>

      <!-- Service 3 - Medium -->
      <div
        class="service-card md:col-span-6 lg:col-span-4 glass p-32 rounded-3xl group hover:border-electric-500/50 border border-transparent transition-all duration-500"
        data-tilt
      >
        <div class="flex flex-col h-full justify-between min-h-[400px]">
          <div>
            <div
              class="w-64 h-64 mb-24 bg-electric-500/10 rounded-2xl flex items-center justify-center group-hover:bg-electric-500/20 transition-all duration-300"
            >
              <svg class="w-32 h-32 text-electric-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-16 group-hover:text-electric-500 transition-colors">
              Performance Optimization
            </h3>
            <p class="text-neutral-light/70 leading-relaxed">
              Got a slow site? We'll make it fly. Core Web Vitals, bundle optimization, and advanced
              caching strategies.
            </p>
          </div>
          <div class="flex flex-wrap gap-8 mt-24">
            <span class="text-xs px-12 py-4 bg-electric-500/10 text-electric-500 rounded-full">
              Lighthouse
            </span>
            <span class="text-xs px-12 py-4 bg-electric-500/10 text-electric-500 rounded-full">
              Optimization
            </span>
          </div>
        </div>
      </div>

      <!-- Service 4 - Large -->
      <div
        class="service-card md:col-span-6 lg:col-span-8 glass p-32 md:p-48 rounded-3xl group hover:border-neon-500/50 border border-transparent transition-all duration-500"
        data-tilt
      >
        <div class="flex flex-col h-full justify-between min-h-[400px]">
          <div>
            <div
              class="w-64 h-64 mb-24 bg-neon-500/10 rounded-2xl flex items-center justify-center group-hover:bg-neon-500/20 transition-all duration-300"
            >
              <svg class="w-32 h-32 text-neon-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                ></path>
              </svg>
            </div>
            <h3 class="text-3xl font-bold mb-16 group-hover:text-neon-500 transition-colors">
              Interactive Experiences
            </h3>
            <p class="text-neutral-light/70 leading-relaxed mb-24">
              Scroll animations, micro-interactions, and delightful details that make your brand
              unforgettable. Built with GSAP, Framer Motion, and custom WebGL.
            </p>
          </div>
          <div class="flex flex-wrap gap-8">
            <span class="text-xs px-12 py-4 bg-neon-500/10 text-neon-500 rounded-full">GSAP</span>
            <span class="text-xs px-12 py-4 bg-neon-500/10 text-neon-500 rounded-full">
              Framer Motion
            </span>
            <span class="text-xs px-12 py-4 bg-neon-500/10 text-neon-500 rounded-full">
              Three.js
            </span>
            <span class="text-xs px-12 py-4 bg-neon-500/10 text-neon-500 rounded-full">WebGL</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initServicesAnimations() {
    // 3D tilt effect on cards
    const cards = document.querySelectorAll('[data-tilt]');

    cards.forEach((card) => {
      const cardElement = card as HTMLElement;

      cardElement.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = cardElement.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = ((y - centerY) / centerY) * -5; // Max 5deg rotation
        const rotateY = ((x - centerX) / centerX) * 5;

        cardElement.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
      });

      cardElement.addEventListener('mouseleave', () => {
        cardElement.style.transform =
          'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      });
    });

    // Stagger animation for cards
    gsap.from('.service-card', {
      opacity: 0,
      y: 50,
      duration: 0.8,
      stagger: 0.15,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.bento-grid',
        start: 'top 70%',
      },
    });

    // Slide up animations
    const slideUpElements = document.querySelectorAll('[data-animate="slide-up"]');
    slideUpElements.forEach((element) => {
      gsap.from(element, {
        y: 50,
        opacity: 0,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: element,
          start: 'top 80%',
        },
      });
    });

    // Fade in animations
    const fadeInElements = document.querySelectorAll('[data-animate="fade-in"]');
    fadeInElements.forEach((element) => {
      const delay = parseFloat(element.getAttribute('data-delay') || '0');
      gsap.from(element, {
        opacity: 0,
        y: 30,
        duration: 1,
        delay: delay,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: element,
          start: 'top 80%',
        },
      });
    });
  }

  document.addEventListener('astro:page-load', initServicesAnimations);
</script>

<style>
  .service-card {
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Prevent text selection during tilt */
  [data-tilt] {
    user-select: none;
  }
</style>
