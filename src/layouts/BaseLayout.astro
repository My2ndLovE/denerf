---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = 'Denerf | Creative Development Agency - Building the Future',
  description = 'We build digital experiences that perform. No fluff. Just craft. Award-worthy web applications with cutting-edge technology.',
  image = '/og-image.jpg',
  canonical = Astro.url.pathname,
  noindex = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://denerf.com';
const fullUrl = new URL(canonical, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={fullUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Denerf" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@denerf" />

    <!-- Performance Optimizations -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Denerf",
      "description": description,
      "url": siteUrl,
      "logo": `${siteUrl}/logo.png`,
      "sameAs": [
        "https://twitter.com/denerf",
        "https://github.com/denerf",
        "https://linkedin.com/company/denerf"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Sales",
        "email": "hello@denerf.com"
      }
    })} />

    <!-- View Transitions with fallback -->
    <ViewTransitions fallback="swap" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />

    <!-- Apple Touch Icon -->
    <link rel="apple-touch-icon" href="/favicon.svg" />
  </head>
  <body>
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="skip-link" aria-label="Skip to main content">
      Skip to main content
    </a>

    <main id="main-content" role="main">
      <slot />
    </main>

    <!-- Screen reader announcements -->
    <div aria-live="polite" aria-atomic="true" class="sr-only" id="sr-announcements"></div>

    <!-- Styles -->
    <style is:global>
      /* Skip link */
      .skip-link {
        position: absolute;
        top: -100%;
        left: 0;
        z-index: 9999;
        padding: 1rem 1.5rem;
        background: var(--color-brand-cyan);
        color: var(--color-brand-black);
        font-family: var(--font-display);
        font-weight: 600;
        text-decoration: none;
        border-radius: 0 0 0.5rem 0;
        transition: top 0.2s ease;
      }

      .skip-link:focus {
        top: 0;
      }

      /* Screen reader only */
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }
    </style>

    <!-- Global error handler -->
    <script is:inline>
      window.addEventListener('error', (e) => console.error('Error:', e.error));
      window.addEventListener('unhandledrejection', (e) => console.error('Unhandled rejection:', e.reason));
    </script>
  </body>
</html>
