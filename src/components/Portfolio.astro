---
// Portfolio Component - 3D Carousel with Morphing Transitions
const projects = [
  {
    id: 1,
    title: 'FinTech Dashboard',
    category: 'Web Application',
    description: 'Real-time analytics platform processing $50M+ daily transactions',
    tech: ['React', 'Node.js', 'PostgreSQL', 'Redis'],
    image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=600&fit=crop',
    color: '#00FF88',
  },
  {
    id: 2,
    title: 'HealthSync',
    category: 'Mobile App',
    description: 'AI-powered health monitoring app with 500K+ active users',
    tech: ['React Native', 'TensorFlow', 'Firebase'],
    image: 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&h=600&fit=crop',
    color: '#FF0099',
  },
  {
    id: 3,
    title: 'CloudScale',
    category: 'Infrastructure',
    description: 'Auto-scaling microservices architecture handling 10M requests/day',
    tech: ['Kubernetes', 'Docker', 'AWS', 'Terraform'],
    image: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=800&h=600&fit=crop',
    color: '#00FF88',
  },
  {
    id: 4,
    title: 'ShopStream',
    category: 'E-Commerce',
    description: 'Next-gen shopping experience with AR product visualization',
    tech: ['Next.js', 'Three.js', 'Stripe', 'Prisma'],
    image: 'https://images.unsplash.com/photo-1557821552-17105176677c?w=800&h=600&fit=crop',
    color: '#FF0099',
  },
];
---

<section id="work" class="relative py-32 px-6 sm:px-8 lg:px-12 bg-primary-panel/30">
  <!-- Section Header -->
  <div class="max-w-7xl mx-auto mb-20 reveal">
    <p class="font-mono text-primary-magenta text-sm mb-4 terminal-text">Case Studies</p>
    <h2 class="text-5xl md:text-7xl font-bold mb-6">
      <span class="text-white">Featured</span>
      <span class="block text-primary-magenta neon-glow">Work</span>
    </h2>
    <p class="text-xl text-primary-text/70 max-w-2xl">
      Projects that pushed boundaries and delivered exceptional results
    </p>
  </div>

  <!-- 3D Carousel -->
  <div class="max-w-7xl mx-auto reveal">
    <div class="relative h-[600px] md:h-[700px]">
      <!-- Project Cards -->
      <div id="carousel-container" class="relative w-full h-full perspective-grid">
        {projects.map((project, index) => (
          <div
            class="project-card absolute top-1/2 left-1/2 w-full max-w-4xl -translate-x-1/2 -translate-y-1/2 transition-all duration-700 ease-out"
            data-index={index}
            style={`opacity: ${index === 0 ? '1' : '0'}; transform: translate(-50%, -50%) scale(${index === 0 ? '1' : '0.8'}); z-index: ${index === 0 ? '10' : '1'};`}
          >
            <div class="relative h-full bg-primary-bg border-2 border-primary-text/20 overflow-hidden group hover:border-primary-accent/50 transition-colors">
              <!-- Project Image with Overlay -->
              <div class="relative h-2/3 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-t from-primary-bg via-primary-bg/50 to-transparent z-10"></div>
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                  loading="lazy"
                />
                <!-- Category Tag -->
                <div class="absolute top-6 left-6 z-20 px-4 py-2 bg-primary-bg/80 backdrop-blur-sm border border-primary-accent/50 font-mono text-sm text-primary-accent">
                  {project.category}
                </div>
              </div>

              <!-- Project Info -->
              <div class="relative h-1/3 p-8 flex flex-col justify-between">
                <div>
                  <h3 class="text-3xl md:text-4xl font-bold text-white mb-3 group-hover:text-primary-accent transition-colors">
                    {project.title}
                  </h3>
                  <p class="text-primary-text/70 text-lg mb-4">
                    {project.description}
                  </p>
                </div>

                <!-- Tech Stack -->
                <div class="flex flex-wrap gap-2">
                  {project.tech.map((tech) => (
                    <span class="px-3 py-1 bg-primary-panel border border-primary-text/20 text-primary-text/80 text-sm font-mono rounded-sm">
                      {tech}
                    </span>
                  ))}
                </div>

                <!-- Corner Accent -->
                <div
                  class="absolute bottom-0 right-0 w-32 h-32 border-r-2 border-b-2 opacity-30"
                  style={`border-color: ${project.color};`}
                ></div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Navigation -->
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 flex items-center gap-8 z-20">
        <button
          id="prev-btn"
          class="w-12 h-12 border-2 border-primary-accent text-primary-accent hover:bg-primary-accent hover:text-primary-bg transition-all duration-300 flex items-center justify-center group"
          aria-label="Previous project"
        >
          <svg class="w-6 h-6 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <!-- Indicators -->
        <div class="flex gap-3">
          {projects.map((_, index) => (
            <button
              class="carousel-indicator w-3 h-3 rounded-full border-2 border-primary-accent transition-all duration-300"
              data-slide={index}
              style={`background-color: ${index === 0 ? '#00FF88' : 'transparent'};`}
              aria-label={`Go to project ${index + 1}`}
            ></button>
          ))}
        </div>

        <button
          id="next-btn"
          class="w-12 h-12 border-2 border-primary-accent text-primary-accent hover:bg-primary-accent hover:text-primary-bg transition-all duration-300 flex items-center justify-center group"
          aria-label="Next project"
        >
          <svg class="w-6 h-6 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Stats Section -->
  <div class="max-w-7xl mx-auto mt-32 reveal">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {[
        { metric: '98%', label: 'Client Satisfaction', icon: '⭐' },
        { metric: '2.5M+', label: 'Users Impacted', icon: '👥' },
        { metric: '24/7', label: 'Support Available', icon: '🛟' },
      ].map((stat) => (
        <div class="text-center p-8 border-2 border-primary-text/10 bg-gradient-to-br from-primary-accent/5 to-transparent hover:border-primary-accent/30 transition-all group">
          <div class="text-5xl mb-4 transform group-hover:scale-110 transition-transform">{stat.icon}</div>
          <div class="text-4xl md:text-5xl font-bold text-primary-accent mb-2">{stat.metric}</div>
          <div class="text-primary-text/70 font-mono text-sm">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  let currentSlide = 0;
  const cards = document.querySelectorAll('.project-card') as NodeListOf<HTMLElement>;
  const indicators = document.querySelectorAll('.carousel-indicator') as NodeListOf<HTMLElement>;
  const totalSlides = cards.length;

  function updateCarousel(newIndex: number) {
    // Update cards
    cards.forEach((card, index) => {
      const isActive = index === newIndex;
      const isPrev = index === (newIndex - 1 + totalSlides) % totalSlides;
      const isNext = index === (newIndex + 1) % totalSlides;

      if (isActive) {
        card.style.opacity = '1';
        card.style.transform = 'translate(-50%, -50%) scale(1) rotateY(0deg)';
        card.style.zIndex = '10';
      } else if (isPrev) {
        card.style.opacity = '0.3';
        card.style.transform = 'translate(-120%, -50%) scale(0.8) rotateY(20deg)';
        card.style.zIndex = '5';
      } else if (isNext) {
        card.style.opacity = '0.3';
        card.style.transform = 'translate(20%, -50%) scale(0.8) rotateY(-20deg)';
        card.style.zIndex = '5';
      } else {
        card.style.opacity = '0';
        card.style.transform = 'translate(-50%, -50%) scale(0.6)';
        card.style.zIndex = '1';
      }
    });

    // Update indicators
    indicators.forEach((indicator, index) => {
      if (index === newIndex) {
        indicator.style.backgroundColor = '#00FF88';
        indicator.style.transform = 'scale(1.3)';
      } else {
        indicator.style.backgroundColor = 'transparent';
        indicator.style.transform = 'scale(1)';
      }
    });

    currentSlide = newIndex;
  }

  // Navigation buttons
  document.getElementById('prev-btn')?.addEventListener('click', () => {
    updateCarousel((currentSlide - 1 + totalSlides) % totalSlides);
  });

  document.getElementById('next-btn')?.addEventListener('click', () => {
    updateCarousel((currentSlide + 1) % totalSlides);
  });

  // Indicator buttons
  indicators.forEach((indicator, index) => {
    indicator.addEventListener('click', () => {
      updateCarousel(index);
    });
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      updateCarousel((currentSlide - 1 + totalSlides) % totalSlides);
    } else if (e.key === 'ArrowRight') {
      updateCarousel((currentSlide + 1) % totalSlides);
    }
  });

  // Auto-advance (optional)
  // setInterval(() => {
  //   updateCarousel((currentSlide + 1) % totalSlides);
  // }, 5000);
</script>

<style>
  .project-card {
    transform-style: preserve-3d;
  }

  .perspective-grid {
    perspective: 2000px;
  }
</style>
