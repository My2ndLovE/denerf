---
// Section 5: The Invitation - Contact CTA
---

<section id="contact" class="section-padding relative overflow-hidden bg-surface">
  <!-- Background -->
  <div class="absolute inset-0 neural-grid opacity-30"></div>

  <div class="container-custom relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-12 animate-on-scroll">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        Ready to Build the <span class="text-gradient">Impossible</span>?
      </h2>
      <p class="text-xl text-text-secondary max-w-3xl mx-auto mb-4">
        Tell us your idea. We'll tell you how AI can make it real.<br />
        Get a personalized project estimate in 24 hours.
      </p>

      <!-- Trust Signals -->
      <div class="flex flex-wrap justify-center gap-6 text-sm text-text-tertiary mt-8">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-success" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Your idea is safe. We sign NDAs. Always.</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-success" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Response within 24 hours, usually faster</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-success" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>No commitment required</span>
        </div>
      </div>
    </div>

    <!-- Conversational Form -->
    <div class="max-w-3xl mx-auto">
      <div class="bg-void rounded-2xl border border-elevated p-8 shadow-2xl shadow-primary/5" id="chat-container">
        <!-- Chat Messages -->
        <div class="space-y-6 mb-6" id="chat-messages">
          <!-- Initial Bot Message -->
          <div class="flex gap-4 items-start bot-message">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-void" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <div class="flex-1">
              <div class="bg-elevated rounded-2xl rounded-tl-none p-4">
                <p class="text-text-primary" id="bot-text-0">
                  Hi! I'm here to help bring your project to life.
                  Let's start with the basics...
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Input Area -->
        <div id="input-container">
          <!-- Question 1: Name -->
          <div class="form-step active" data-step="1">
            <label class="block text-sm font-medium text-text-secondary mb-2">
              What's your name?
            </label>
            <input
              type="text"
              id="name-input"
              class="w-full px-4 py-3 bg-surface border border-elevated rounded-lg focus:border-primary focus:outline-none text-text-primary placeholder-text-tertiary"
              placeholder="John Doe"
              required
            />
            <button
              class="btn-primary mt-4 w-full sm:w-auto"
              onclick="nextStep(1)"
            >
              Continue →
            </button>
          </div>

          <!-- Question 2: Email -->
          <div class="form-step" data-step="2">
            <label class="block text-sm font-medium text-text-secondary mb-2">
              <span id="name-display">Hi!</span> What's your email?
            </label>
            <input
              type="email"
              id="email-input"
              class="w-full px-4 py-3 bg-surface border border-elevated rounded-lg focus:border-primary focus:outline-none text-text-primary placeholder-text-tertiary"
              placeholder="john@example.com"
              required
            />
            <button
              class="btn-primary mt-4 w-full sm:w-auto"
              onclick="nextStep(2)"
            >
              Continue →
            </button>
          </div>

          <!-- Question 3: Project Description -->
          <div class="form-step" data-step="3">
            <label class="block text-sm font-medium text-text-secondary mb-2">
              Great! Tell me about your project idea.
              What's the impossible thing you want to build?
            </label>
            <textarea
              id="project-input"
              rows="4"
              class="w-full px-4 py-3 bg-surface border border-elevated rounded-lg focus:border-primary focus:outline-none text-text-primary placeholder-text-tertiary resize-none"
              placeholder="I want to build..."
              required
            ></textarea>
            <button
              class="btn-primary mt-4 w-full sm:w-auto"
              onclick="nextStep(3)"
            >
              Continue →
            </button>
          </div>

          <!-- Question 4: Timeline -->
          <div class="form-step" data-step="4">
            <label class="block text-sm font-medium text-text-secondary mb-2">
              Love it! When do you want to launch?
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <button
                class="timeline-option px-4 py-3 border border-elevated rounded-lg hover:border-primary hover:bg-primary/10 transition-all duration-300 text-sm"
                data-value="ASAP"
              >
                ASAP
              </button>
              <button
                class="timeline-option px-4 py-3 border border-elevated rounded-lg hover:border-primary hover:bg-primary/10 transition-all duration-300 text-sm"
                data-value="1-3 months"
              >
                1-3 months
              </button>
              <button
                class="timeline-option px-4 py-3 border border-elevated rounded-lg hover:border-primary hover:bg-primary/10 transition-all duration-300 text-sm"
                data-value="3-6 months"
              >
                3-6 months
              </button>
              <button
                class="timeline-option px-4 py-3 border border-elevated rounded-lg hover:border-primary hover:bg-primary/10 transition-all duration-300 text-sm"
                data-value="Just exploring"
              >
                Just exploring
              </button>
            </div>
          </div>

          <!-- Question 5: Challenge -->
          <div class="form-step" data-step="5">
            <label class="block text-sm font-medium text-text-secondary mb-2">
              Last question: What's your biggest challenge right now?
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <button
                class="challenge-option px-4 py-3 border border-elevated rounded-lg hover:border-primary hover:bg-primary/10 transition-all duration-300 text-sm text-left"
                data-value="Too slow"
              >
                Too slow
              </button>
              <button
                class="challenge-option px-4 py-3 border border-elevated rounded-lg hover:border-primary hover:bg-primary/10 transition-all duration-300 text-sm text-left"
                data-value="Too expensive"
              >
                Too expensive
              </button>
              <button
                class="challenge-option px-4 py-3 border border-elevated rounded-lg hover:border-primary hover:bg-primary/10 transition-all duration-300 text-sm text-left"
                data-value="Too complex"
              >
                Too complex
              </button>
              <button
                class="challenge-option px-4 py-3 border border-elevated rounded-lg hover:border-primary hover:bg-primary/10 transition-all duration-300 text-sm text-left"
                data-value="Need AI expertise"
              >
                Need AI expertise
              </button>
              <button
                class="challenge-option px-4 py-3 border border-elevated rounded-lg hover:border-primary hover:bg-primary/10 transition-all duration-300 text-sm text-left col-span-full sm:col-span-2"
                data-value="Not sure where to start"
              >
                Not sure where to start
              </button>
            </div>
          </div>

          <!-- Processing State -->
          <div class="form-step" data-step="processing" style="display: none;">
            <div class="text-center py-8">
              <div class="inline-block w-16 h-16 border-4 border-primary border-t-transparent rounded-full animate-spin mb-4"></div>
              <p class="text-lg text-text-primary font-semibold">Analyzing your project...</p>
              <p class="text-sm text-text-secondary mt-2">Our AI is processing your information</p>
            </div>
          </div>

          <!-- Success State -->
          <div class="form-step" data-step="success" style="display: none;">
            <div class="text-center py-8">
              <div class="w-20 h-20 rounded-full bg-success/20 flex items-center justify-center mx-auto mb-6">
                <svg class="w-10 h-10 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold mb-4">🎉 Got it!</h3>
              <p class="text-lg text-text-secondary mb-6">
                Here's what happens next:
              </p>
              <div class="text-left max-w-md mx-auto space-y-4 mb-8">
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0">
                    <span class="text-sm font-bold text-primary">1</span>
                  </div>
                  <p class="text-sm text-text-secondary pt-1">
                    Our AI analyzes your project (happening now)
                  </p>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0">
                    <span class="text-sm font-bold text-primary">2</span>
                  </div>
                  <p class="text-sm text-text-secondary pt-1">
                    You'll receive a personalized response within 24 hours
                  </p>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0">
                    <span class="text-sm font-bold text-primary">3</span>
                  </div>
                  <p class="text-sm text-text-secondary pt-1">
                    If it's a good fit, we'll schedule a call to discuss
                  </p>
                </div>
              </div>
              <p class="text-xl font-semibold text-gradient mb-6">
                Your impossible idea? Consider it possible.
              </p>
              <a href="#hero" class="btn-secondary inline-block">
                Back to Top
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Alternative Contact -->
      <div class="text-center mt-8 text-sm text-text-tertiary">
        <p>Prefer email? <a href="mailto:hello@denerf.ai" class="text-primary hover:underline">hello@denerf.ai</a></p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  let currentStep = 1;
  const formData = {
    name: '',
    email: '',
    project: '',
    timeline: '',
    challenge: '',
  };

  function addBotMessage(message) {
    const messagesContainer = document.getElementById('chat-messages');
    const messageDiv = document.createElement('div');
    messageDiv.className = 'flex gap-4 items-start bot-message opacity-0 translate-y-4';
    messageDiv.innerHTML = `
      <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center flex-shrink-0">
        <svg class="w-6 h-6 text-void" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
      </div>
      <div class="flex-1">
        <div class="bg-elevated rounded-2xl rounded-tl-none p-4">
          <p class="text-text-primary">${message}</p>
        </div>
      </div>
    `;
    messagesContainer.appendChild(messageDiv);

    // Animate in
    setTimeout(() => {
      messageDiv.classList.remove('opacity-0', 'translate-y-4');
      messageDiv.classList.add('transition-all', 'duration-500');
    }, 100);

    // Scroll to bottom
    messageDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function addUserMessage(message) {
    const messagesContainer = document.getElementById('chat-messages');
    const messageDiv = document.createElement('div');
    messageDiv.className = 'flex gap-4 items-start justify-end user-message opacity-0 translate-y-4';
    messageDiv.innerHTML = `
      <div class="flex-1 flex justify-end">
        <div class="bg-primary rounded-2xl rounded-tr-none p-4 max-w-md">
          <p class="text-void">${message}</p>
        </div>
      </div>
    `;
    messagesContainer.appendChild(messageDiv);

    // Animate in
    setTimeout(() => {
      messageDiv.classList.remove('opacity-0', 'translate-y-4');
      messageDiv.classList.add('transition-all', 'duration-500');
    }, 100);

    // Scroll to bottom
    messageDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function nextStep(step) {
    // Validate and store data
    if (step === 1) {
      const name = document.getElementById('name-input').value.trim();
      if (!name) {
        alert('Please enter your name');
        return;
      }
      formData.name = name;
      addUserMessage(name);
      document.getElementById('name-display').textContent = `Hi ${name}!`;
    } else if (step === 2) {
      const email = document.getElementById('email-input').value.trim();
      if (!email || !email.includes('@')) {
        alert('Please enter a valid email');
        return;
      }
      formData.email = email;
      addUserMessage(email);
    } else if (step === 3) {
      const project = document.getElementById('project-input').value.trim();
      if (!project) {
        alert('Please describe your project');
        return;
      }
      formData.project = project;
      addUserMessage(project);
    }

    // Hide current step
    document.querySelectorAll('.form-step').forEach(el => {
      el.style.display = 'none';
      el.classList.remove('active');
    });

    // Show next step
    currentStep = step + 1;
    const nextStepEl = document.querySelector(`[data-step="${currentStep}"]`);
    if (nextStepEl) {
      setTimeout(() => {
        nextStepEl.style.display = 'block';
        nextStepEl.classList.add('active');
      }, 500);
    }
  }

  // Timeline selection
  document.addEventListener('DOMContentLoaded', () => {
    const timelineOptions = document.querySelectorAll('.timeline-option');
    timelineOptions.forEach(option => {
      option.addEventListener('click', () => {
        const value = option.getAttribute('data-value');
        formData.timeline = value;
        addUserMessage(value);
        nextStep(4);
      });
    });

    // Challenge selection
    const challengeOptions = document.querySelectorAll('.challenge-option');
    challengeOptions.forEach(option => {
      option.addEventListener('click', () => {
        const value = option.getAttribute('data-value');
        formData.challenge = value;
        addUserMessage(value);
        submitForm();
      });
    });
  });

  async function submitForm() {
    // Show processing
    document.querySelectorAll('.form-step').forEach(el => {
      el.style.display = 'none';
    });
    document.querySelector('[data-step="processing"]').style.display = 'block';

    // Simulate processing (replace with actual API call)
    setTimeout(() => {
      console.log('Form data:', formData);

      // Show success
      document.querySelector('[data-step="processing"]').style.display = 'none';
      document.querySelector('[data-step="success"]').style.display = 'block';

      // Confetti effect
      if (typeof confetti !== 'undefined') {
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 }
        });
      }
    }, 2000);
  }
</script>

<style>
  .form-step {
    display: none;
    animation: fadeInUp 0.5s ease-out;
  }

  .form-step.active {
    display: block;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .timeline-option.selected,
  .challenge-option.selected {
    @apply border-primary bg-primary/20;
  }
</style>
