---
// Tech Stack Component - Interactive Constellation Network
const technologies = [
  { name: 'React', category: 'frontend', x: 20, y: 30, connections: ['Next.js', 'TypeScript', 'Tailwind'] },
  { name: 'Next.js', category: 'frontend', x: 35, y: 20, connections: ['React', 'Node.js', 'Vercel'] },
  { name: 'TypeScript', category: 'language', x: 50, y: 35, connections: ['React', 'Node.js', 'Next.js'] },
  { name: 'Node.js', category: 'backend', x: 65, y: 25, connections: ['TypeScript', 'PostgreSQL', 'Next.js'] },
  { name: 'Python', category: 'language', x: 80, y: 40, connections: ['TensorFlow', 'FastAPI'] },
  { name: 'PostgreSQL', category: 'database', x: 70, y: 55, connections: ['Node.js', 'Prisma'] },
  { name: 'MongoDB', category: 'database', x: 55, y: 65, connections: ['Node.js'] },
  { name: 'Redis', category: 'database', x: 40, y: 60, connections: ['Node.js'] },
  { name: 'Tailwind', category: 'frontend', x: 15, y: 50, connections: ['React', 'Next.js'] },
  { name: 'Docker', category: 'devops', x: 25, y: 75, connections: ['Kubernetes', 'AWS'] },
  { name: 'Kubernetes', category: 'devops', x: 45, y: 80, connections: ['Docker', 'AWS'] },
  { name: 'AWS', category: 'cloud', x: 65, y: 75, connections: ['Kubernetes', 'Docker', 'Vercel'] },
  { name: 'Vercel', category: 'cloud', x: 80, y: 65, connections: ['Next.js', 'AWS'] },
  { name: 'TensorFlow', category: 'ai', x: 85, y: 55, connections: ['Python'] },
  { name: 'Prisma', category: 'backend', x: 60, y: 45, connections: ['PostgreSQL', 'TypeScript'] },
  { name: 'FastAPI', category: 'backend', x: 75, y: 50, connections: ['Python'] },
];

const categories = {
  frontend: { color: '#00FF88', label: 'Frontend' },
  backend: { color: '#FF0099', label: 'Backend' },
  database: { color: '#00D9FF', label: 'Database' },
  devops: { color: '#FFD700', label: 'DevOps' },
  cloud: { color: '#9D4EDD', label: 'Cloud' },
  language: { color: '#FF6B6B', label: 'Languages' },
  ai: { color: '#4ECDC4', label: 'AI/ML' },
};
---

<section id="tech" class="relative py-32 px-6 sm:px-8 lg:px-12 overflow-hidden">
  <!-- Background Gradient Orbs -->
  <div class="absolute top-20 left-10 w-96 h-96 bg-primary-accent/10 rounded-full blur-3xl animate-pulse"></div>
  <div class="absolute bottom-20 right-10 w-96 h-96 bg-primary-magenta/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>

  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="mb-20 reveal text-center">
      <p class="font-mono text-primary-accent text-sm mb-4 terminal-text inline-block">Technology Arsenal</p>
      <h2 class="text-5xl md:text-7xl font-bold mb-6">
        <span class="text-white">Powered By</span>
        <span class="block text-primary-accent neon-glow">Cutting-Edge Tech</span>
      </h2>
      <p class="text-xl text-primary-text/70 max-w-2xl mx-auto">
        We leverage the latest tools and frameworks to build exceptional solutions
      </p>
    </div>

    <!-- Interactive Network Graph -->
    <div class="reveal mb-20">
      <div id="tech-constellation" class="relative w-full h-[600px] border-2 border-primary-text/10 bg-primary-panel/20 overflow-hidden">
        <!-- SVG for connections -->
        <svg id="connections-svg" class="absolute inset-0 w-full h-full pointer-events-none z-0">
          <defs>
            <filter id="glow">
              <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
              <feMerge>
                <feMergeNode in="coloredBlur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>
        </svg>

        <!-- Tech Nodes -->
        <div id="nodes-container" class="relative w-full h-full">
          {technologies.map((tech, index) => (
            <div
              class="tech-node absolute cursor-pointer group"
              data-tech={tech.name}
              data-category={tech.category}
              data-connections={tech.connections.join(',')}
              style={`left: ${tech.x}%; top: ${tech.y}%; transform: translate(-50%, -50%);`}
              data-index={index}
            >
              <!-- Node Circle -->
              <div
                class="relative w-20 h-20 rounded-full border-3 flex items-center justify-center transition-all duration-300 group-hover:scale-150 group-hover:shadow-2xl"
                style={`
                  border-color: ${categories[tech.category as keyof typeof categories].color};
                  background: radial-gradient(circle, ${categories[tech.category as keyof typeof categories].color}20, transparent);
                  box-shadow: 0 0 20px ${categories[tech.category as keyof typeof categories].color}40;
                `}
              >
                <!-- Pulse Ring -->
                <div
                  class="absolute inset-0 rounded-full animate-ping opacity-20"
                  style={`background-color: ${categories[tech.category as keyof typeof categories].color};`}
                ></div>

                <!-- Label -->
                <span
                  class="text-xs font-mono font-bold z-10 text-center"
                  style={`color: ${categories[tech.category as keyof typeof categories].color};`}
                >
                  {tech.name}
                </span>
              </div>

              <!-- Hover Tooltip -->
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-4 px-4 py-2 bg-primary-bg border-2 text-white text-sm font-mono whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-20"
                style={`border-color: ${categories[tech.category as keyof typeof categories].color};`}
              >
                {tech.name}
                <div class="text-xs text-primary-text/60">{categories[tech.category as keyof typeof categories].label}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Legend -->
      <div class="mt-8 flex flex-wrap justify-center gap-6">
        {Object.entries(categories).map(([key, { color, label }]) => (
          <button
            class="category-filter px-4 py-2 border-2 font-mono text-sm transition-all duration-300 hover:scale-110"
            data-category={key}
            style={`border-color: ${color}30; color: ${color};`}
          >
            <span class="inline-block w-3 h-3 rounded-full mr-2" style={`background-color: ${color};`}></span>
            {label}
          </button>
        ))}
      </div>
    </div>

    <!-- Tech Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 reveal">
      {Object.entries(categories).slice(0, 6).map(([key, { color, label }]) => (
        <div class="group p-8 border-2 border-primary-text/10 hover:border-opacity-50 transition-all bg-gradient-to-br from-transparent to-primary-panel/20" style={`--hover-color: ${color};`}>
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-full flex items-center justify-center" style={`background: ${color}20; border: 2px solid ${color}40;`}>
              <div class="w-6 h-6 rounded-full" style={`background: ${color};`}></div>
            </div>
            <h3 class="text-2xl font-bold text-white group-hover:text-primary-accent transition-colors">
              {label}
            </h3>
          </div>
          <p class="text-primary-text/70 text-sm leading-relaxed">
            Industry-leading {label.toLowerCase()} technologies for scalable, performant applications
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const nodes = document.querySelectorAll('.tech-node') as NodeListOf<HTMLElement>;
  const svg = document.getElementById('connections-svg') as SVGSVGElement;
  const container = document.getElementById('tech-constellation');
  let activeCategory: string | null = null;

  // Draw connections between nodes
  function drawConnections() {
    if (!svg || !container) return;

    // Clear existing lines
    svg.innerHTML = svg.innerHTML.replace(/<line[\s\S]*?<\/line>/g, '');

    const containerRect = container.getBoundingClientRect();

    nodes.forEach((node) => {
      const techName = node.dataset.tech;
      const connections = node.dataset.connections?.split(',') || [];
      const category = node.dataset.category;

      // Skip if filtered out
      if (activeCategory && category !== activeCategory) return;

      const nodeRect = node.getBoundingClientRect();
      const x1 = nodeRect.left - containerRect.left + nodeRect.width / 2;
      const y1 = nodeRect.top - containerRect.top + nodeRect.height / 2;

      connections.forEach((connName) => {
        const connNode = Array.from(nodes).find((n) => n.dataset.tech === connName) as HTMLElement;
        if (!connNode) return;

        const connCategory = connNode.dataset.category;
        if (activeCategory && connCategory !== activeCategory) return;

        const connRect = connNode.getBoundingClientRect();
        const x2 = connRect.left - containerRect.left + connRect.width / 2;
        const y2 = connRect.top - containerRect.top + connRect.height / 2;

        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', x1.toString());
        line.setAttribute('y1', y1.toString());
        line.setAttribute('x2', x2.toString());
        line.setAttribute('y2', y2.toString());
        line.setAttribute('stroke', '#00FF88');
        line.setAttribute('stroke-width', '1');
        line.setAttribute('opacity', '0.2');
        line.setAttribute('filter', 'url(#glow)');
        line.classList.add('connection-line');

        svg.appendChild(line);
      });
    });
  }

  // Highlight connections on hover
  nodes.forEach((node) => {
    node.addEventListener('mouseenter', () => {
      const connections = node.dataset.connections?.split(',') || [];
      const techName = node.dataset.tech;

      nodes.forEach((n) => {
        const name = n.dataset.tech;
        if (name === techName || connections.includes(name || '')) {
          n.style.opacity = '1';
          n.style.zIndex = '10';
        } else {
          n.style.opacity = '0.3';
        }
      });

      // Highlight connected lines
      const lines = svg.querySelectorAll('.connection-line');
      lines.forEach((line) => {
        const svgLine = line as SVGLineElement;
        svgLine.setAttribute('opacity', '0.05');
      });
    });

    node.addEventListener('mouseleave', () => {
      nodes.forEach((n) => {
        n.style.opacity = '1';
        n.style.zIndex = '';
      });

      const lines = svg.querySelectorAll('.connection-line');
      lines.forEach((line) => {
        const svgLine = line as SVGLineElement;
        svgLine.setAttribute('opacity', '0.2');
      });
    });
  });

  // Category filters
  const filters = document.querySelectorAll('.category-filter');
  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const category = filter.getAttribute('data-category');

      if (activeCategory === category) {
        // Deactivate filter
        activeCategory = null;
        filter.classList.remove('bg-primary-accent', 'text-primary-bg');
        nodes.forEach((node) => {
          node.style.display = 'block';
        });
      } else {
        // Activate filter
        activeCategory = category;
        filters.forEach((f) => f.classList.remove('bg-primary-accent', 'text-primary-bg'));
        filter.classList.add('bg-primary-accent', 'text-primary-bg');

        nodes.forEach((node) => {
          if (node.dataset.category === category) {
            node.style.display = 'block';
          } else {
            node.style.display = 'none';
          }
        });
      }

      drawConnections();
    });
  });

  // Initial draw
  setTimeout(drawConnections, 100);

  // Redraw on window resize
  window.addEventListener('resize', drawConnections);
</script>

<style>
  .tech-node {
    z-index: 1;
    transition: opacity 0.3s ease, z-index 0.3s ease;
  }

  .connection-line {
    transition: opacity 0.3s ease;
  }
</style>
