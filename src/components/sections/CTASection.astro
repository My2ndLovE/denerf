---
import MagneticButton from '../ui/MagneticButton.astro';
---

<section id="contact" class="relative section-padding bg-space-600 overflow-hidden">
  <!-- Animated Background Gradient -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="blob absolute -top-48 -left-48 w-96 h-96 bg-electric-500/20 rounded-full"></div>
    <div
      class="blob absolute -bottom-48 -right-48 w-128 h-128 bg-neon-500/15 rounded-full"
      style="animation-delay: -3s;"
    >
    </div>
  </div>

  <div class="container-custom relative z-10">
    <!-- Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-64 items-center">
      <!-- Left: Compelling Copy -->
      <div class="cta-content">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-24 leading-tight" data-animate="slide-up">
          Ready to Build Something
          <span class="gradient-text block mt-8">Extraordinary?</span>
        </h2>

        <p class="text-xl text-neutral-light/70 mb-32 leading-relaxed" data-animate="fade-in" data-delay="0.2">
          Let's create a digital experience that doesn't just meet expectations—it shatters them.
          Fast, beautiful, and built to convert.
        </p>

        <!-- Value Props -->
        <div class="space-y-16 mb-48" data-animate="fade-in" data-delay="0.3">
          <div class="flex items-start gap-16">
            <div class="w-24 h-24 flex-shrink-0 bg-electric-500/10 rounded-lg flex items-center justify-center">
              <svg class="w-16 h-16 text-electric-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-lg mb-4">100 Lighthouse Scores</h3>
              <p class="text-neutral-light/60">We don't ship until it's perfect.</p>
            </div>
          </div>

          <div class="flex items-start gap-16">
            <div class="w-24 h-24 flex-shrink-0 bg-neon-500/10 rounded-lg flex items-center justify-center">
              <svg class="w-16 h-16 text-neon-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-lg mb-4">2-Week Turnaround</h3>
              <p class="text-neutral-light/60">From kickoff to launch, fast.</p>
            </div>
          </div>

          <div class="flex items-start gap-16">
            <div class="w-24 h-24 flex-shrink-0 bg-electric-500/10 rounded-lg flex items-center justify-center">
              <svg class="w-16 h-16 text-electric-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-lg mb-4">Fixed Pricing</h3>
              <p class="text-neutral-light/60">No surprises, ever.</p>
            </div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-16" data-animate="fade-in" data-delay="0.4">
          <MagneticButton href="mailto:hello@denerf.com" variant="primary" size="large">
            Start Your Project
          </MagneticButton>
          <MagneticButton href="#portfolio" variant="outline" size="large">
            See Case Studies
          </MagneticButton>
        </div>
      </div>

      <!-- Right: Interactive Contact Form -->
      <div class="cta-form" data-animate="scale-in" data-delay="0.2">
        <div class="glass p-32 md:p-48 rounded-3xl">
          <h3 class="text-2xl font-bold mb-24">Quick Start Form</h3>

          <form class="space-y-24" id="contact-form">
            <!-- Name Field -->
            <div class="form-group">
              <label for="name" class="block text-sm font-medium mb-8 text-neutral-light/80">
                What's your name?
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-16 py-12 bg-space-500/50 border border-neutral-light/10 rounded-xl focus:border-electric-500 focus:outline-none focus:ring-2 focus:ring-electric-500/20 transition-all text-neutral-light placeholder-neutral-light/40"
                placeholder="John Doe"
              />
            </div>

            <!-- Email Field -->
            <div class="form-group">
              <label for="email" class="block text-sm font-medium mb-8 text-neutral-light/80">
                Your email address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-16 py-12 bg-space-500/50 border border-neutral-light/10 rounded-xl focus:border-electric-500 focus:outline-none focus:ring-2 focus:ring-electric-500/20 transition-all text-neutral-light placeholder-neutral-light/40"
                placeholder="john@example.com"
              />
            </div>

            <!-- Project Type -->
            <div class="form-group">
              <label for="project-type" class="block text-sm font-medium mb-8 text-neutral-light/80">
                What are you building?
              </label>
              <select
                id="project-type"
                name="project-type"
                required
                class="w-full px-16 py-12 bg-space-500/50 border border-neutral-light/10 rounded-xl focus:border-electric-500 focus:outline-none focus:ring-2 focus:ring-electric-500/20 transition-all text-neutral-light"
              >
                <option value="">Select project type</option>
                <option value="web-app">Web Application</option>
                <option value="website">Marketing Website</option>
                <option value="ecommerce">E-Commerce</option>
                <option value="saas">SaaS Platform</option>
                <option value="other">Something Else</option>
              </select>
            </div>

            <!-- Message Field -->
            <div class="form-group">
              <label for="message" class="block text-sm font-medium mb-8 text-neutral-light/80">
                Tell us about your project
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                class="w-full px-16 py-12 bg-space-500/50 border border-neutral-light/10 rounded-xl focus:border-electric-500 focus:outline-none focus:ring-2 focus:ring-electric-500/20 transition-all text-neutral-light placeholder-neutral-light/40 resize-none"
                placeholder="I need a website that..."
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full px-32 py-16 bg-electric-500 text-space-500 font-semibold rounded-full hover:bg-electric-400 transition-all duration-300 hover:scale-105 shadow-lg shadow-electric-500/50"
            >
              Send Message
            </button>
          </form>

          <!-- Success Message (Hidden by default) -->
          <div id="success-message" class="hidden mt-24 p-16 bg-neon-500/10 border border-neon-500/30 rounded-xl">
            <p class="text-neon-500 text-center">
              Thanks! We'll get back to you within 24 hours.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="mt-128 pt-64 border-t border-neutral-light/10">
      <div class="flex flex-col md:flex-row justify-between items-center gap-32">
        <!-- Logo/Brand -->
        <div>
          <h3 class="text-2xl font-bold gradient-text">Denerf</h3>
          <p class="text-neutral-light/60 text-sm mt-4">Performance-First Development</p>
        </div>

        <!-- Links -->
        <div class="flex gap-32 text-sm">
          <a href="#hero" class="text-neutral-light/60 hover:text-electric-500 transition-colors">
            Home
          </a>
          <a href="#philosophy" class="text-neutral-light/60 hover:text-electric-500 transition-colors">
            Philosophy
          </a>
          <a href="#services" class="text-neutral-light/60 hover:text-electric-500 transition-colors">
            Services
          </a>
          <a href="#portfolio" class="text-neutral-light/60 hover:text-electric-500 transition-colors">
            Work
          </a>
        </div>

        <!-- Social Links -->
        <div class="flex gap-16">
          <a
            href="https://github.com/denerf"
            target="_blank"
            rel="noopener noreferrer"
            class="w-40 h-40 flex items-center justify-center bg-neutral-light/5 hover:bg-electric-500/20 rounded-full transition-all hover:scale-110"
            aria-label="GitHub"
          >
            <svg class="w-20 h-20 text-neutral-light/60" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </a>
          <a
            href="https://twitter.com/denerf"
            target="_blank"
            rel="noopener noreferrer"
            class="w-40 h-40 flex items-center justify-center bg-neutral-light/5 hover:bg-electric-500/20 rounded-full transition-all hover:scale-110"
            aria-label="Twitter"
          >
            <svg class="w-20 h-20 text-neutral-light/60" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Copyright -->
      <div class="mt-32 text-center text-sm text-neutral-light/40">
        <p>&copy; {new Date().getFullYear()} Denerf Agency. Built with Astro & GSAP.</p>
      </div>
    </footer>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initCTAAnimations() {
    // Slide up animations
    const slideUpElements = document.querySelectorAll('[data-animate="slide-up"]');
    slideUpElements.forEach((element) => {
      gsap.from(element, {
        y: 50,
        opacity: 0,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: element,
          start: 'top 80%',
        },
      });
    });

    // Fade in animations
    const fadeInElements = document.querySelectorAll('[data-animate="fade-in"]');
    fadeInElements.forEach((element) => {
      const delay = parseFloat(element.getAttribute('data-delay') || '0');
      gsap.from(element, {
        opacity: 0,
        y: 30,
        duration: 1,
        delay: delay,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: element,
          start: 'top 80%',
        },
      });
    });

    // Scale in animations
    const scaleInElements = document.querySelectorAll('[data-animate="scale-in"]');
    scaleInElements.forEach((element) => {
      const delay = parseFloat(element.getAttribute('data-delay') || '0');
      gsap.from(element, {
        scale: 0.9,
        opacity: 0,
        duration: 1,
        delay: delay,
        ease: 'back.out(1.7)',
        scrollTrigger: {
          trigger: element,
          start: 'top 80%',
        },
      });
    });

    // Form interaction animations
    const form = document.getElementById('contact-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // Show success message
        const successMessage = document.getElementById('success-message');
        if (successMessage) {
          gsap.to(form, {
            opacity: 0,
            y: -20,
            duration: 0.3,
            onComplete: () => {
              form.style.display = 'none';
              successMessage.classList.remove('hidden');
              gsap.from(successMessage, {
                opacity: 0,
                y: 20,
                duration: 0.5,
                ease: 'power2.out',
              });
            },
          });
        }
      });

      // Animate form inputs on focus
      const inputs = form.querySelectorAll('input, textarea, select');
      inputs.forEach((input) => {
        input.addEventListener('focus', () => {
          gsap.to(input, {
            scale: 1.02,
            duration: 0.2,
            ease: 'power2.out',
          });
        });

        input.addEventListener('blur', () => {
          gsap.to(input, {
            scale: 1,
            duration: 0.2,
            ease: 'power2.out',
          });
        });
      });
    }
  }

  document.addEventListener('astro:page-load', initCTAAnimations);
</script>
